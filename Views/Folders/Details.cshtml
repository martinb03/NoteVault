@using NoteVault.ViewModels
@model NoteVault.ViewModels.FolderDetailsViewModel

@{
ViewData["Title"] = Model.Name;
Layout = "_Layout";

var manageNotesPileId = Context.Request.Query["manageNotes"].ToString();
var reorderPilesMode = Context.Request.Query["reorderPiles"] == "1";
var reorderNotesPileId = Context.Request.Query["reorderNotesInPile"].ToString();

int? activeManagePileId = int.TryParse(manageNotesPileId, out var mp) ? mp : null;
int? activeReorderNotesPileId = int.TryParse(reorderNotesPileId, out var rp) ? rp : null;
bool manageMode = activeManagePileId.HasValue;
bool reorderMode = reorderPilesMode;
bool anyModeActive = manageMode || reorderMode || activeReorderNotesPileId.HasValue;

var activeManagePile = activeManagePileId.HasValue
? Model.PinnedPiles.Concat(Model.Piles).FirstOrDefault(p => p.Id == activeManagePileId.Value)
: null;
var notesInActivePile = activeManagePile?.Notes.Select(n => n.Id).ToHashSet() ?? new HashSet<int>();

var swatchColors = new[] { "#FF6B6B", "#FFA94D", "#FFD93D", "#6BCB77", "#4D96FF", "#9B72CF", "#FF6BB5", "#868E96" };
var swatchIcons = new[]
{
"bi-collection", "bi-bookmark", "bi-star", "bi-heart", "bi-pin", "bi-tag",
"bi-flag", "bi-bell", "bi-archive", "bi-folder", "bi-file-earmark", "bi-cup-hot",
"bi-house", "bi-briefcase", "bi-book", "bi-music-note", "bi-camera", "bi-controller",
"bi-tools", "bi-gift", "bi-lightning", "bi-puzzle", "bi-palette", "bi-globe",
"bi-rocket", "bi-egg", "bi-trophy", "bi-gear", "bi-bullseye", "bi-lightbulb"
};

ViewData["Breadcrumb"] = new List<BreadcrumbItem>
{
new("Folders", Url.Action("Index", "Folders")),
new(Model.Name)
};
}

<partial name="_Breadcrumb"/>

<div class="folder-details @(anyModeActive ? "mode-active" : "")">
    <div class="folder-cols">

        <!-- ═══════ Left Sidebar: Folder Info ═══════ -->
        <aside class="folder-left">
            <div class="folder-hero">
                <i class="bi bi-folder folder-hero-icon"></i>
                <h1 class="folder-hero-title">@Model.Name</h1>
            </div>

            <div class="folder-info-section">
                <div class="folder-info-label">Description</div>
                <p class="folder-info-value">
                    @(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)
                </p>
            </div>

            <div class="folder-info-section">
                <div class="folder-info-label">Created</div>
                <p class="folder-info-value">
                    <partial name="_LocalDate" model="Model.CreatedAt"/>
                </p>
            </div>

            @if (anyModeActive)
            {
            <div class="folder-mode-indicator">
                <i class="bi bi-info-circle"></i>
                @if (manageMode)
                {
                <span>Managing notes for <strong>@activeManagePile?.Name</strong>. Check notes to include.</span>
                }
                else if (reorderMode)
                {
                <span>Reordering piles. Use the arrows to reorder.</span>
                }
                else
                {
                <span>Reordering notes within the pile. Use the arrows to reorder.</span>
                }
            </div>
            }
        </aside>

        <!-- ═══════ Center: Content ═══════ -->
        <main class="folder-center">

            @if (TempData["Success"] != null)
            {
            <div class="nv-alert alert alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill alert-icon"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            }

            @if (manageMode)
            {
            <form asp-controller="Piles" asp-action="ManageNotes" method="post" id="manageNotesForm">
                <input type="hidden" name="PileId" value="@activeManagePileId"/>
            </form>
            }

            <!-- Pinned Piles -->
            @if (Model.PinnedPiles.Any())
            {
            <div class="folder-section-header">
                <i class="bi bi-pin-fill"></i>
                <span>Pinned Piles</span>
            </div>
            <div class="trash-list mb-3" id="pinned-piles-container">
                @foreach (var pile in Model.PinnedPiles)
                {
                @await Html.PartialAsync("_FolderPile", new ViewDataDictionary(ViewData)
                {
                { "Pile", pile },
                { "IsPinned", true },
                { "ActiveManagePileId", activeManagePileId },
                { "ActiveReorderNotesPileId", activeReorderNotesPileId },
                { "ManageMode", manageMode },
                { "ReorderMode", reorderMode },
                { "AnyModeActive", anyModeActive },
                { "NotesInActivePile", notesInActivePile },
                { "SwatchColors", swatchColors },
                { "SwatchIcons", swatchIcons }
                })
                }
            </div>
            }

            <!-- Regular Piles -->
            @if (Model.Piles.Any())
            {
            <div class="folder-section-header">
                <i class="bi bi-collection"></i>
                <span>Piles</span>
            </div>
            <div class="trash-list mb-3" id="piles-container">
                @foreach (var pile in Model.Piles)
                {
                @await Html.PartialAsync("_FolderPile", new ViewDataDictionary(ViewData)
                {
                { "Pile", pile },
                { "IsPinned", false },
                { "ActiveManagePileId", activeManagePileId },
                { "ActiveReorderNotesPileId", activeReorderNotesPileId },
                { "ManageMode", manageMode },
                { "ReorderMode", reorderMode },
                { "AnyModeActive", anyModeActive },
                { "NotesInActivePile", notesInActivePile },
                { "SwatchColors", swatchColors },
                { "SwatchIcons", swatchIcons }
                })
                }
            </div>
            }

            <!-- Loose Notes -->
            @if (Model.Notes.Any())
            {
            <div class="folder-section-header">
                <i class="bi bi-journal-text"></i>
                <span>Notes</span>
            </div>
            <div class="trash-list mb-3">
                @foreach (var note in Model.Notes)
                {
                if (manageMode)
                {
                <div class="trash-row">
                    <input type="checkbox" name="NoteIds" value="@note.Id" form="manageNotesForm"
                           class="form-check-input" checked="@notesInActivePile.Contains(note.Id)"/>
                    <i class="bi bi-journal-text row-icon"></i>
                    <span class="row-title">@note.Title</span>
                    @await Html.PartialAsync("_NoteTagsInline", note.Tags)
                    <span class="row-meta ms-auto">
                                    <partial name="_LocalDate" model="note.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                                </span>
                </div>
                }
                else
                {
                <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id"
                   class="trash-row text-decoration-none">
                    <i class="bi bi-journal-text row-icon"></i>
                    <span class="row-title">@note.Title</span>
                    @await Html.PartialAsync("_NoteTagsInline", note.Tags)
                    <span class="row-meta ms-auto">
                                    <partial name="_LocalDate" model="note.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                                </span>
                </a>
                }
                }
            </div>
            }

            <!-- Empty state -->
            @if (!Model.PinnedPiles.Any() && !Model.Piles.Any() && !Model.Notes.Any())
            {
            <div class="empty-state">
                <i class="bi bi-folder2-open"></i>
                <p>This folder is empty.</p>
                <p style="font-size: 0.85rem; opacity: 0.8;">Create a note or pile to get started.</p>
            </div>
            }
        </main>

        <!-- ═══════ Right Sidebar: Actions ═══════ -->
        <aside class="folder-right">
            <div class="action-list">
                <button class="action-item @(anyModeActive ? "disabled" : "")"
                        data-bs-toggle="modal" data-bs-target="#createNoteModal" disabled="@anyModeActive">
                    <i class="bi bi-journal-plus"></i> New Note
                </button>
                <button class="action-item @(anyModeActive ? "disabled" : "")"
                        data-bs-toggle="modal" data-bs-target="#createPileModal" disabled="@anyModeActive">
                    <i class="bi bi-collection"></i> New Pile
                </button>
                <button class="action-item @(anyModeActive ? "disabled" : "")"
                        data-bs-toggle="modal" data-bs-target="#editFolderModal" disabled="@anyModeActive">
                    <i class="bi bi-pencil"></i> Edit
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" asp-route-reorderPiles="1"
                   class="action-item @(anyModeActive ? "disabled pe-none" : "")">
                    <i class="bi bi-arrow-down-up"></i> Reorder Piles
                </a>
                <a asp-action="Export" asp-route-id="@Model.Id"
                   class="action-item @(anyModeActive ? "disabled pe-none" : "")">
                    <i class="bi bi-download"></i> Export
                </a>
                <button class="action-item text-danger @(anyModeActive ? "disabled" : "")"
                        data-bs-toggle="modal" data-bs-target="#deleteFolderModal" disabled="@anyModeActive">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>

            @if (manageMode)
            {
            <div class="action-list mode-actions">
                <button type="submit" form="manageNotesForm" class="action-item action-save">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="action-item">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            }
            else if (reorderMode)
            {
            <div class="action-list mode-actions">
                <button type="button" id="savePileOrderBtn" class="action-item action-save">
                    <i class="bi bi-check-lg"></i> Save
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="action-item">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            }
            else if (activeReorderNotesPileId.HasValue)
            {
            <div class="action-list mode-actions">
                <button type="button" id="saveReorderBtn" class="action-item action-save">
                    <i class="bi bi-check-lg"></i> Save
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="action-item">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            }
        </aside>
    </div>
</div>

@* ═══════ Modals ═══════ *@
@await Html.PartialAsync("_FolderDetailsModals", new ViewDataDictionary(ViewData)
{
{ "FolderId", Model.Id },
{ "FolderName", Model.Name },
{ "FolderDescription", Model.Description },
{ "SwatchColors", swatchColors },
{ "SwatchIcons", swatchIcons }
})

<style>
    /* ─── Layout ─────────────────────────────────────── */
    .folder-details {
        max-width: 1400px;
        margin: 0.5rem auto 2rem auto;
        padding: 0 1.5rem;
    }
    .folder-cols {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }
    .folder-left { flex: 0 0 22%; }
    .folder-center { flex: 1; min-width: 0; }
    
    .folder-center .trash-list {
        overflow: visible;
    }
    
    .folder-center .trash-row .row-title{
        flex-grow:0;
        margin-right:0.5rem;
    }
    
    .folder-right { flex: 0 0 16%; position: sticky; top: 80px; }

    /* ─── Left: Hero + Info ──────────────────────────── */
    .folder-hero {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }
    .folder-hero-icon {
        font-size: 1.5rem;
        color: var(--brand-orange);
    }
    .folder-hero-title {
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .folder-info-section { margin-bottom: 1.25rem; }
    .folder-info-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        color: var(--text-secondary);
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--border-soft);
        margin-bottom: 0.5rem;
    }
    .folder-info-value {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-primary);
        word-wrap: break-word;
    }
    .folder-info-value:empty::after,
    .folder-info-section .folder-info-value.muted {
        color: var(--text-secondary);
        font-style: italic;
    }

    .folder-mode-indicator {
        margin-top: 1.5rem;
        padding: 0.65rem 0.85rem;
        background-color: var(--surface-warm);
        border: 1px solid var(--border-warm);
        border-radius: var(--radius-card);
        font-size: 0.8rem;
        color: var(--text-primary);
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
    }
    .folder-mode-indicator i {
        color: var(--brand-orange);
        font-size: 0.95rem;
        flex-shrink: 0;
        margin-top: 0.1rem;
    }

    /* ─── Center: Section Headers ────────────────────── */
    .folder-section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 0.5rem;
        margin-top: 0.5rem;
    }
    .folder-section-header i {
        color: var(--brand-orange);
        font-size: 0.95rem;
    }

    /* ─── Right: Action List (custom border style) ───── */
    .action-list {
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .action-list + .action-list { margin-top: 1rem; }
    .action-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 0.5rem;
        background: transparent;
        border: 0;
        color: var(--text-medium);
        font-size: 0.9rem;
        font-weight: 500;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.15s;
        width: 100%;
    }
    /* Subtle fade-edge top border via ::before */
    .action-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 15%;
        right: 15%;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-soft) 30%, var(--border-soft) 70%, transparent);
        transition: left 0.2s, right 0.2s, background 0.2s, height 0.2s;
    }
    /* Bottom border via ::after */
    .action-item::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 15%;
        right: 15%;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-soft) 30%, var(--border-soft) 70%, transparent);
        transition: left 0.2s, right 0.2s, background 0.2s, height 0.2s;
    }
    /* First item top border invisible, last item bottom border invisible (cleaner edges) */
    .action-list .action-item:first-child::before { opacity: 0; }
    .action-list .action-item:last-child::after { opacity: 0; }

    .action-item:hover {
        color: var(--brand-orange);
    }
    .action-item:hover::before,
    .action-item:hover::after {
        left: 0;
        right: 0;
        height: 1.5px;
        background: linear-gradient(to right, transparent, var(--brand-orange) 20%, var(--brand-orange) 80%, transparent);
    }
    /* Make the item below a hovered one also light its top border */
    .action-item:hover + .action-item::before {
        left: 0;
        right: 0;
        height: 1.5px;
        background: linear-gradient(to right, transparent, var(--brand-orange) 20%, var(--brand-orange) 80%, transparent);
    }

    .action-item i {
        font-size: 1rem;
        color: var(--brand-orange);
        opacity: 0.85;
        width: 1.2rem;
        flex-shrink: 0;
    }
    .action-item.text-danger { color: var(--danger); }
    .action-item.text-danger i { color: var(--danger); }
    .action-item.disabled {
        opacity: 0.5;
        pointer-events: none;
    }

    .mode-actions {
        background: var(--surface-warm);
        border: 1px solid var(--border-warm);
        border-radius: var(--radius-card);
        padding: 0.25rem 0.75rem;
        animation: mode-pop 0.25s ease-out;
    }
    .mode-actions .action-item.action-save {
        color: var(--brand-orange);
        font-weight: 600;
    }
    @@keyframes mode-pop {
        from { transform: scale(0.96); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    /* ─── Mode-active page dim ───────────────────────── */
    .folder-details.mode-active .folder-center {
        opacity: 0.85;
    }
    .folder-details.mode-active .folder-left {
        opacity: 0.85;
    }

    /* ─── Pile rows ──────────────────────────────────── */
    .pile-block { display: contents; }
    .pile-row {
        position: relative;
        border-bottom: 1px solid var(--border-soft);
        overflow: visible;
        display: block;
    }
    .pile-row:last-child { border-bottom: none; }

    .pile-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.75rem 1rem;
        background: transparent;
        border: 0;
        text-align: left;
        cursor: pointer;
        width: 100%;
        color: inherit;
        transition: background-color 0.15s;
    }
    .pile-header:hover { background-color: var(--hover-warm); }
    .pile-header:disabled { cursor: default; }
    .pile-header:disabled:hover { background-color: transparent; }
    .pile-header .pile-chevron {
        display: inline-block;
        font-size: 0.75rem;
        color: var(--text-secondary);
        transition: transform 0.15s;
        flex-shrink: 0;
    }
    .pile-header[aria-expanded="true"] .pile-chevron {
        transform: rotate(90deg);
    }
    .pile-header .pile-icon {
        color: var(--brand-orange);
        opacity: 0.85;
        font-size: 1rem;
        flex-shrink: 0;
    }
    .pile-header .pile-name {
        font-weight: 600;
        color: var(--text-primary);
        flex-grow: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .pile-header .pile-count {
        font-size: 0.75rem;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .pile-row.left-color { border-left-width: 4px; border-left-style: solid; }

    .pile-contents {
        background: var(--surface-warm);
        padding: 0.5rem 1rem 0.75rem 3rem;
        border-top: 1px solid var(--border-soft);
    }
    .pile-note-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.5rem;
        border-radius: 6px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s;
    }
    .pile-note-row:hover {
        background-color: rgba(var(--brand-orange-rgb), 0.08);
        color: inherit;
    }
    .pile-note-row .row-icon {
        color: var(--brand-orange);
        opacity: 0.7;
        font-size: 0.95rem;
        flex-shrink: 0;
    }
    .pile-note-row .row-title {
        font-size: 0.9rem;
        color: var(--text-primary);
        flex-grow: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .pile-note-row.no-hover:hover { background-color: transparent; }

    /* Reorder arrow buttons */
    .reorder-arrows {
        display: flex;
        flex-direction: column;
        margin-left: 1rem;
        flex-shrink: 0;
    }
    .reorder-arrows button {
        background: transparent;
        border: 0;
        padding: 0;
        color: var(--text-secondary);
        line-height: 1;
        cursor: pointer;
        transition: color 0.15s;
    }
    .reorder-arrows button:hover { color: var(--brand-orange); }
    .reorder-arrows button i { font-size: 0.75rem; }

    /* Pile dropdown menu button */
    .pile-menu-btn {
        background: transparent;
        border: 0;
        color: var(--text-secondary);
        padding: 0.3rem 0.5rem;
        border-radius: 50%;
        cursor: pointer;
        line-height: 1;
        flex-shrink: 0;
        margin-right: 0.5rem;
        transition: background-color 0.15s, color 0.15s;
    }
    .pile-menu-btn:hover {
        background-color: rgba(0, 0, 0, 0.06);
        color: var(--text-primary);
    }

    /* Swatch and icon picker */
    .pile-color-swatches {
        display: flex;
        gap: 0.45rem;
        flex-wrap: wrap;
    }
    .pile-color-swatch {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        transition: transform 0.1s;
    }
    .pile-color-swatch:hover { transform: scale(1.1); }
    .pile-color-swatch.selected {
        outline: 3px solid var(--brand-orange);
        outline-offset: 2px;
    }
    .pile-icon-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 0.45rem;
    }
    .pile-icon-option {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        border: 1.5px solid var(--border-warm);
        border-radius: 8px;
        background: var(--surface);
        cursor: pointer;
        transition: border-color 0.15s, background-color 0.15s;
    }
    .pile-icon-option:hover {
        border-color: var(--brand-orange);
        background-color: var(--hover-warm);
    }
    .pile-icon-option.selected {
        border-color: var(--brand-orange);
        background-color: var(--hover-warm);
    }
    .pile-icon-option i {
        color: var(--brand-orange);
        font-size: 1.1rem;
    }

    @@media (max-width: 992px) {
        .folder-cols { flex-direction: column; }
        .folder-left, .folder-right { flex: 1 1 100%; width: 100%; position: static; }
    }
</style>

<script>
    // ─── Swatch / Icon picker visual selection ───────
    document.querySelectorAll('input[name="Color"]').forEach(input => {
        input.addEventListener('change', function() {
            this.closest('.modal').querySelectorAll('.pile-color-swatch').forEach(s => s.classList.remove('selected'));
            this.closest('.pile-color-swatch').classList.add('selected');
        });
    });

    document.querySelectorAll('input[name="Icon"]').forEach(input => {
        input.addEventListener('change', function() {
            this.closest('.modal').querySelectorAll('.pile-icon-option').forEach(s => s.classList.remove('selected'));
            this.closest('.pile-icon-option').classList.add('selected');
        });
    });

    // ─── Edit Pile setup ─────────────────────────────
    function setEditPile(id, name, color, icon) {
        document.getElementById('editPileId').value = id;
        document.getElementById('editPileName').value = name;
        document.querySelectorAll('#editPileModal .pile-color-swatch').forEach(s => s.classList.remove('selected'));
        document.querySelectorAll('#editPileModal .pile-icon-option').forEach(s => s.classList.remove('selected'));
        document.querySelectorAll('#editPileModal input[name="Color"]').forEach(input => {
            input.checked = (input.value === color);
            if (input.checked) input.closest('.pile-color-swatch').classList.add('selected');
        });
        document.querySelectorAll('#editPileModal input[name="Icon"]').forEach(input => {
            input.checked = (input.value === icon);
            if (input.checked) input.closest('.pile-icon-option').classList.add('selected');
        });
    }

    function setDeletePile(id, name) {
        document.getElementById('deletePileId').value = id;
        document.getElementById('deletePileName').textContent = name;
    }
</script>

@if (activeReorderNotesPileId.HasValue)
{
<script>
    const reorderPileId = @activeReorderNotesPileId;
    const noteContainer = document.getElementById(`pile-notes-${reorderPileId}`);

    document.querySelectorAll('.reorder-up').forEach(btn => {
        btn.addEventListener('click', function() {
            const row = this.closest('.trash-row');
            const prev = row.previousElementSibling;
            if (prev && prev.classList.contains('trash-row')) {
                row.parentNode.insertBefore(row, prev);
            }
        });
    });
    document.querySelectorAll('.reorder-down').forEach(btn => {
        btn.addEventListener('click', function() {
            const row = this.closest('.trash-row');
            const next = row.nextElementSibling;
            if (next && next.classList.contains('trash-row')) {
                row.parentNode.insertBefore(next, row);
            }
        });
    });

    document.getElementById('saveReorderBtn').addEventListener('click', async function() {
        const noteIds = Array.from(noteContainer.querySelectorAll('.trash-row'))
            .map(el => parseInt(el.dataset.noteId));
        await fetch('/Piles/SaveNoteOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pileId: reorderPileId, noteIds: noteIds })
        });
        window.location.href = `/Folders/Details/@Model.Id`;
    });
</script>
}

@if (reorderMode)
{
<script>
    function pileReorderHandler(direction) {
        return function() {
            const row = this.closest('.pile-row');
            const sibling = direction === 'up' ? row.previousElementSibling : row.nextElementSibling;
            if (sibling && sibling.classList.contains('pile-row')) {
                if (direction === 'up') row.parentNode.insertBefore(row, sibling);
                else row.parentNode.insertBefore(sibling, row);
            }
        };
    }
    document.querySelectorAll('.pile-reorder-up').forEach(b => b.addEventListener('click', pileReorderHandler('up')));
    document.querySelectorAll('.pile-reorder-down').forEach(b => b.addEventListener('click', pileReorderHandler('down')));

    document.getElementById('savePileOrderBtn').addEventListener('click', async function() {
        const allPiles = Array.from(document.querySelectorAll('.pile-row'));
        const pileIds = allPiles.map(el => parseInt(el.dataset.pileId));
        await fetch('/Piles/SavePileOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ folderId: @Model.Id, pileIds: pileIds })
        });
        window.location.href = `/Folders/Details/@Model.Id`;
    });
</script>
}
