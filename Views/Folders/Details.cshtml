@using NoteVault.ViewModels
@model NoteVault.ViewModels.FolderDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";

    var manageNotesPileId = Context.Request.Query["manageNotes"].ToString();
    var reorderPilesMode = Context.Request.Query["reorderPiles"] == "1";
    var reorderNotesPileId = Context.Request.Query["reorderNotesInPile"].ToString();

    int? activeManagePileId = int.TryParse(manageNotesPileId, out var mp) ? mp : null;
    int? activeReorderNotesPileId = int.TryParse(reorderNotesPileId, out var rp) ? rp : null;
    bool manageMode = activeManagePileId.HasValue;
    bool reorderMode = reorderPilesMode;
    bool anyModeActive = manageMode || reorderMode || activeReorderNotesPileId.HasValue;

    var activeManagePile = activeManagePileId.HasValue
        ? Model.PinnedPiles.Concat(Model.Piles).FirstOrDefault(p => p.Id == activeManagePileId.Value)
        : null;
    var notesInActivePile = activeManagePile?.Notes.Select(n => n.Id).ToHashSet() ?? new HashSet<int>();

    var swatchColors = new[] { "#FF6B6B", "#FFA94D", "#FFD93D", "#6BCB77", "#4D96FF", "#9B72CF", "#FF6BB5", "#868E96" };
    var swatchIcons = new[] { "📦", "🍝", "🚗", "💼", "📚", "🎵", "🏠", "⚙️", "💡", "🎯" };
}

<style>
    .pile-row {
        overflow: visible;
    }
    .pile-header {
        background: none;
        border: none;
        padding: 0.75rem 1rem;
        width: 100%;
        text-align: left;
        transition: background-color 0.15s;
        display: flex;
        align-items: center;
        color: inherit;
    }
    .pile-header:hover {
        background-color: #f8f9fa;
    }
    .pile-header:disabled {
        cursor: default;
    }
    .pile-header:disabled:hover {
        background-color: transparent;
    }
    .pile-note-row {
        display: flex;
        align-items: center;
        padding: 0.5rem 0;
        border-top: 1px solid #dee2e6;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s;
        margin: 0 -0.5rem;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        border-radius: 4px;
    }
    .pile-note-row:hover {
        background-color: #f8f9fa;
        color: inherit;
    }
    .pile-note-row.no-hover:hover {
        background-color: transparent;
    }
</style>

<div class="container-fluid mt-4 px-5">
    @{
        ViewData["Breadcrumb"] = new List<BreadcrumbItem>
        {
            new("Folders", Url.Action("Index", "Folders")),
            new(Model.Name)
        };
    }
    <partial name="_Breadcrumb"/>
    
    <h4 class="mb-4 text-center">📁 @Model.Name</h4>

    <!-- Content + sidebar row -->
    <div class="row">
        <!-- Left Column: description + metadata -->
        <div class="col-md-2">
            <div class="mb-0">
                <small class="text-muted text-uppercase fw-bold">Description</small>
            </div>
            <hr/>
            <div class="mb-5">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted mb-1" >@Model.Description</p>
                }
                else
                {
                    <p class="text-muted mb-1" >No description.</p>
                }
            </div>
            <div class="mb-0">
                <small class="text-muted text-uppercase fw-bold">Info</small>
            </div>
            <hr/>
            <div class="text-muted" style="font-size: 15px">
                Created at:
                <div class="fw-bold">
                    <partial name="_LocalDate" model="Model.CreatedAt"/>
                </div>
            </div>
        </div>

        <!-- Center column: Content -->
        <div class="col-md-8" style="background-color: #ffffff;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (manageMode)
            {
                <div class="alert alert-info mb-3 mt-3">
                    <strong>Managing notes for:</strong> @activeManagePile?.Name. Check notes to include in this pile.
                </div>
                <form asp-controller="Piles" asp-action="ManageNotes" method="post" id="manageNotesForm">
                    <input type="hidden" name="PileId" value="@activeManagePileId"/>
                </form>
            }
            else if (reorderMode)
            {
                <div class="alert alert-info mb-3 mt-3">
                    <strong>Reordering piles.</strong> Use the arrows to move piles within their group. Click Save when done.
                </div>
            }
            else if (activeReorderNotesPileId.HasValue)
            {
                <div class="alert alert-info mb-3 mt-3">
                    <strong>Reordering notes.</strong> Use the arrows to move notes. Click Save when done.
                </div>
            }

            <!-- ======= Pinned Piles ======= -->
            @if (Model.PinnedPiles.Any())
            {
                <h6 class="text-muted text-uppercase small mb-2 mt-4">📌 Pinned Piles</h6>
                <div class="card mb-3">
                    <div class="list-group list-group-flush" id="pinned-piles-container">
                        @for (int i = 0; i < Model.PinnedPiles.Count; i++)
                        {
                            var pile = Model.PinnedPiles[i];
                            var isActivePileForManage = activeManagePileId == pile.Id;
                            var isActivePileForReorderNotes = activeReorderNotesPileId == pile.Id;
                            var expanded = isActivePileForManage || isActivePileForReorderNotes;
                            var canExpand = !reorderMode && (!activeReorderNotesPileId.HasValue || isActivePileForReorderNotes);
                            var showMenu = !anyModeActive;

                            <div class="list-group-item p-0 pile-row" data-pile-id="@pile.Id"
                                 style="@(pile.Color != null ? $"border-left: 4px solid {pile.Color};" : "")">
                                <div class="d-flex align-items-center">

                                    @if (reorderMode)
                                    {
                                        <div class="ms-3 d-flex flex-column">
                                            <button type="button" class="btn btn-sm btn-link p-0 pile-reorder-up">▲</button>
                                            <button type="button" class="btn btn-sm btn-link p-0 pile-reorder-down">▼</button>
                                        </div>
                                    }

                                    <button type="button" class="pile-header flex-grow-1"
                                            data-bs-toggle="@(canExpand ? "collapse" : "")"
                                            data-bs-target="#pile-@pile.Id"
                                            disabled="@(!canExpand)">
                                        <span class="me-3" style="font-size: 1.1rem;">📌</span>
                                        <strong class="flex-grow-1">@pile.Name</strong>
                                        <span class="text-muted me-3" style="min-width: 80px; text-align: right;">
                                            @pile.Notes.Count @(pile.Notes.Count == 1 ? "note" : "notes")
                                        </span>
                                    </button>

                                    @if (showMenu)
                                    {
                                        <div class="dropdown me-3">
                                            <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown" data-bs-strategy="fixed">
                                                <span style="font-size: 1.2rem;">⋮</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" asp-action="Details" asp-controller="Folders" asp-route-id="@Model.Id" asp-route-manageNotes="@pile.Id">Manage Notes</a></li>
                                                <li><a class="dropdown-item" asp-action="Details" asp-controller="Folders" asp-route-id="@Model.Id" asp-route-reorderNotesInPile="@pile.Id">Reorder Notes</a></li>
                                                <li>
                                                    <form asp-controller="Piles" asp-action="TogglePin" method="post" class="m-0">
                                                        <input type="hidden" name="id" value="@pile.Id"/>
                                                        <button type="submit" class="dropdown-item">Unpin</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editPileModal"
                                                            onclick="setEditPile(@pile.Id, '@pile.Name', '@(pile.Color ?? "")', '@(pile.Icon ?? "")')">Edit</button>
                                                </li>
                                                <li><a class="dropdown-item" asp-controller="Piles" asp-action="Export" asp-route-id="@pile.Id" >Export</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deletePileModal"
                                                            onclick="setDeletePile(@pile.Id, '@pile.Name')">Delete</button>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                </div>

                                <div class="collapse @(expanded ? "show" : "")" id="pile-@pile.Id">
                                    <div class="ps-5 pe-3 pb-3" data-pile-id="@pile.Id" id="pile-notes-@pile.Id">
                                        @if (pile.Notes.Any())
                                        {
                                            @foreach (var note in pile.Notes)
                                            {
                                                var rowClasses = "pile-note-row note-row" + (manageMode || isActivePileForReorderNotes ? " no-hover" : "");
                                                if (manageMode || isActivePileForReorderNotes)
                                                {
                                                    <div class="@rowClasses" data-note-id="@note.Id">
                                                        @if (manageMode)
                                                        {
                                                            <input type="checkbox" name="NoteIds" value="@note.Id" form="manageNotesForm"
                                                                   class="form-check-input me-3" checked="@notesInActivePile.Contains(note.Id)"/>
                                                        }
                                                        @if (isActivePileForReorderNotes)
                                                        {
                                                            <div class="me-3 d-flex flex-column">
                                                                <button type="button" class="btn btn-sm btn-link p-0 reorder-up">▲</button>
                                                                <button type="button" class="btn btn-sm btn-link p-0 reorder-down">▼</button>
                                                            </div>
                                                        }
                                                        <span class="me-2">📝</span>
                                                        <span class="me-2">@note.Title</span>
                                                        @foreach (var tag in note.Tags.Take(3))
                                                        {
                                                            <span class="note-tag-badge" style="border-color: @(tag.Color ?? "#868E96"); background-color: @((tag.Color ?? "#868E96") + "33");">@tag.Name</span>
                                                        }
                                                        @if (note.Tags.Count > 3)
                                                        {
                                                            <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id"
                                                       class="@rowClasses" data-note-id="@note.Id">
                                                        <span class="me-2">📝</span>
                                                        <span class="me-2">@note.Title</span>
                                                        @foreach (var tag in note.Tags.Take(3))
                                                        {
                                                            <span class="note-tag-badge" style="border-color: @(tag.Color ?? "#868E96"); background-color: @((tag.Color ?? "#868E96") + "33");">@tag.Name</span>
                                                        }
                                                        @if (note.Tags.Count > 3)
                                                        {
                                                            <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                                                        }
                                                    </a>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0 pt-2">No notes in this pile yet.</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ======= Regular Piles ======= -->
            @if (Model.Piles.Any())
            {
                <h6 class="text-muted text-uppercase small mb-2 mt-4">Piles</h6>
                <div class="card mb-3">
                    <div class="list-group list-group-flush" id="regular-piles-container">
                        @for (int i = 0; i < Model.Piles.Count; i++)
                        {
                            var pile = Model.Piles[i];
                            var isActivePileForManage = activeManagePileId == pile.Id;
                            var isActivePileForReorderNotes = activeReorderNotesPileId == pile.Id;
                            var expanded = isActivePileForManage || isActivePileForReorderNotes;
                            var canExpand = !reorderMode && (!activeReorderNotesPileId.HasValue || isActivePileForReorderNotes);
                            var showMenu = !anyModeActive;

                            <div class="list-group-item p-0 pile-row" data-pile-id="@pile.Id"
                                 style="@(pile.Color != null ? $"border-left: 4px solid {pile.Color};" : "")">
                                <div class="d-flex align-items-center">

                                    @if (reorderMode)
                                    {
                                        <div class="ms-3 d-flex flex-column">
                                            <button type="button" class="btn btn-sm btn-link p-0 pile-reorder-up">▲</button>
                                            <button type="button" class="btn btn-sm btn-link p-0 pile-reorder-down">▼</button>
                                        </div>
                                    }

                                    <button type="button" class="pile-header flex-grow-1"
                                            data-bs-toggle="@(canExpand ? "collapse" : "")"
                                            data-bs-target="#pile-@pile.Id"
                                            disabled="@(!canExpand)">
                                        <span class="me-3" style="font-size: 1.1rem;">@(string.IsNullOrEmpty(pile.Icon) ? "📦" : pile.Icon)</span>
                                        <strong class="flex-grow-1">@pile.Name</strong>
                                        <span class="text-muted me-3" style="min-width: 80px; text-align: right;">
                                            @pile.Notes.Count @(pile.Notes.Count == 1 ? "note" : "notes")
                                        </span>
                                    </button>

                                    @if (showMenu)
                                    {
                                        <div class="dropdown me-3">
                                            <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown" data-bs-strategy="fixed">
                                                <span style="font-size: 1.2rem;">⋮</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" asp-action="Details" asp-controller="Folders" asp-route-id="@Model.Id" asp-route-manageNotes="@pile.Id">Manage Notes</a></li>
                                                <li><a class="dropdown-item" asp-action="Details" asp-controller="Folders" asp-route-id="@Model.Id" asp-route-reorderNotesInPile="@pile.Id">Reorder Notes</a></li>
                                                <li>
                                                    <form asp-controller="Piles" asp-action="TogglePin" method="post" class="m-0">
                                                        <input type="hidden" name="id" value="@pile.Id"/>
                                                        <button type="submit" class="dropdown-item">Pin</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editPileModal"
                                                            onclick="setEditPile(@pile.Id, '@pile.Name', '@(pile.Color ?? "")', '@(pile.Icon ?? "")')">Edit</button>
                                                </li>
                                                <li><a class="dropdown-item" asp-controller="Piles" asp-action="Export" asp-route-id="@pile.Id">Export</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deletePileModal"
                                                            onclick="setDeletePile(@pile.Id, '@pile.Name')">Delete</button>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                </div>

                                <div class="collapse @(expanded ? "show" : "")" id="pile-@pile.Id">
                                    <div class="ps-5 pe-3 pb-3" data-pile-id="@pile.Id" id="pile-notes-@pile.Id">
                                        @if (pile.Notes.Any())
                                        {
                                            @foreach (var note in pile.Notes)
                                            {
                                                var rowClasses = "pile-note-row note-row" + (manageMode || isActivePileForReorderNotes ? " no-hover" : "");
                                                if (manageMode || isActivePileForReorderNotes)
                                                {
                                                    <div class="@rowClasses" data-note-id="@note.Id">
                                                        @if (manageMode)
                                                        {
                                                            <input type="checkbox" name="NoteIds" value="@note.Id" form="manageNotesForm"
                                                                   class="form-check-input me-3" checked="@notesInActivePile.Contains(note.Id)"/>
                                                        }
                                                        @if (isActivePileForReorderNotes)
                                                        {
                                                            <div class="me-3 d-flex flex-column">
                                                                <button type="button" class="btn btn-sm btn-link p-0 reorder-up">▲</button>
                                                                <button type="button" class="btn btn-sm btn-link p-0 reorder-down">▼</button>
                                                            </div>
                                                        }
                                                        <span class="me-2">📝</span>
                                                        <span class="me-2">@note.Title</span>
                                                        @foreach (var tag in note.Tags.Take(3))
                                                        {
                                                            <span class="note-tag-badge" style="border-color: @(tag.Color ?? "#868E96"); background-color: @((tag.Color ?? "#868E96") + "33");">@tag.Name</span>
                                                        }
                                                        @if (note.Tags.Count > 3)
                                                        {
                                                            <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id"
                                                       class="@rowClasses" data-note-id="@note.Id">
                                                        <span class="me-2">📝</span>
                                                        <span class="me-2">@note.Title</span>
                                                        @foreach (var tag in note.Tags.Take(3))
                                                        {
                                                            <span class="note-tag-badge" style="border-color: @(tag.Color ?? "#868E96"); background-color: @((tag.Color ?? "#868E96") + "33");">@tag.Name</span>
                                                        }
                                                        @if (note.Tags.Count > 3)
                                                        {
                                                            <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                                                        }
                                                    </a>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0 pt-2">No notes in this pile yet.</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ======= Loose Notes ======= -->
            @if (Model.Notes.Any())
            {
                <h6 class="text-muted text-uppercase small mb-2 mt-4">Notes</h6>
                <div class="card mb-3">
                    <div class="list-group list-group-flush">
                        @foreach (var note in Model.Notes)
                        {
                            if (manageMode)
                            {
                                <div class="list-group-item d-flex align-items-center py-3">
                                    <input type="checkbox" name="NoteIds" value="@note.Id" form="manageNotesForm"
                                           class="form-check-input me-3" checked="@notesInActivePile.Contains(note.Id)"/>
                                    <span class="me-3" style="font-size: 1.1rem;">📝</span>
                                    <strong class="me-2">@note.Title</strong>
                                    @foreach (var tag in note.Tags.Take(3))
                                    {
                                        <span class="note-tag-badge" style="border-color: @(tag.Color ?? "#868E96"); background-color: @((tag.Color ?? "#868E96") + "33");">@tag.Name</span>
                                    }
                                    @if (note.Tags.Count > 3)
                                    {
                                        <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                                    }
                                    <span class="text-muted ms-auto">
                                        <partial name="_LocalDate" model="note.CreatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="list-group-item list-group-item-action d-flex align-items-center py-3 text-decoration-none">
                                    <span class="me-3" style="font-size: 1.1rem;">📝</span>
                                    <strong class="text-dark me-2">@note.Title</strong>
                                    @foreach (var tag in note.Tags.Take(3))
                                    {
                                        <span class="note-tag-badge" style="border-color: @(tag.Color ?? "#868E96"); background-color: @((tag.Color ?? "#868E96") + "33");">@tag.Name</span>
                                    }
                                    @if (note.Tags.Count > 3)
                                    {
                                        <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                                    }
                                    <span class="text-muted ms-auto">
                                        <partial name="_LocalDate" model="note.CreatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                                    </span>
                                </a>
                            }
                        }
                    </div>
                </div>
            }

            <!-- Empty state -->
            @if (!Model.PinnedPiles.Any() && !Model.Piles.Any() && !Model.Notes.Any())
            {
                <div class="text-center text-muted py-5">
                    <p>This folder is empty.</p>
                    <p>Create a note or pile to get started.</p>
                </div>
            }
        </div>

        <!-- Right column - Sidebar -->
        <div class="col-md-2">
            <div class="card">
                <div class="list-group list-group-flush">
                    <button class="list-group-item list-group-item-action @(anyModeActive ? "disabled" : "")"
                            data-bs-toggle="modal" data-bs-target="#createNoteModal" disabled="@anyModeActive">
                        📝 New Note
                    </button>
                    <button class="list-group-item list-group-item-action @(anyModeActive ? "disabled" : "")"
                            data-bs-toggle="modal" data-bs-target="#createPileModal" disabled="@anyModeActive">
                        📦 New Pile
                    </button>
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="list-group-item list-group-item-action @(anyModeActive ? "disabled pe-none" : "")">
                        ✏️ Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@Model.Id" asp-route-reorderPiles="1"
                       class="list-group-item list-group-item-action @(anyModeActive ? "disabled pe-none" : "")">
                        ⇅ Reorder Piles
                    </a>
                    <a asp-action="Export" asp-route-id="@Model.Id" class="list-group-item list-group-item-action @(anyModeActive ? "disabled pe-none" : "")">
                        📥 Export
                    </a>
                    <button class="list-group-item list-group-item-action text-danger @(anyModeActive ? "disabled" : "")"
                            data-bs-toggle="modal" data-bs-target="#deleteFolderModal" disabled="@anyModeActive">
                        🗑️ Delete
                    </button>
                </div>
            </div>

            @if (manageMode)
            {
                <div class="card mt-3">
                    <div class="list-group list-group-flush">
                        <button type="submit" form="manageNotesForm" class="list-group-item list-group-item-action text-primary fw-bold">
                            ✓ Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                            ✕ Cancel
                        </a>
                    </div>
                </div>
            }
            else if (reorderMode)
            {
                <div class="card mt-3">
                    <div class="list-group list-group-flush">
                        <button type="button" id="savePileOrderBtn" class="list-group-item list-group-item-action text-primary fw-bold">
                            ✓ Save
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                            ✕ Cancel
                        </a>
                    </div>
                </div>
            }
            else if (activeReorderNotesPileId.HasValue)
            {
                <div class="card mt-3">
                    <div class="list-group list-group-flush">
                        <button type="button" id="saveReorderBtn" class="list-group-item list-group-item-action text-primary fw-bold">
                            ✓ Save
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                            ✕ Cancel
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════ Modals ═══════ -->

<!-- Create Pile Modal -->
<div class="modal fade" id="createPileModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Pile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Piles" asp-action="Create" method="post">
