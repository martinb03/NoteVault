<script>
    function setDeletePile(id, name) {
        document.getElementById('deletePileId').value = id;
        document.getElementById('deletePileName').textContent = name;
    }

    function setEditPile(id, name, color, icon) {
        document.getElementById('editPileId').value = id;
        document.getElementById('editPileName').value = name;
        document.querySelectorAll('#editPileModal input[name="Color"]').forEach(input => {
            input.checked = (input.value === color);
        });
        document.querySelectorAll('#editPileModal input[name="Icon"]').forEach(input => {
            input.checked = (input.value === icon);
        });
    }

    document.querySelectorAll('input[name="Color"], input[name="Icon"]').forEach(input => {
        input.addEventListener('change', function() {
            const group = this.name;
            this.closest('.modal').querySelectorAll(`input[name="${group}"]`).forEach(other => {
                other.closest('label').style.outline = (other === this) ? '3px solid #FF8C42' : '';
            });
        });
    });
</script>

@if (activeReorderNotesPileId.HasValue)
{
    <script>
        const reorderPileId = @activeReorderNotesPileId;
        const noteContainer = document.getElementById(`pile-notes-${reorderPileId}`);

        document.querySelectorAll('.reorder-up').forEach(btn => {
            btn.addEventListener('click', function() {
                const row = this.closest('.note-row');
                const prev = row.previousElementSibling;
                if (prev && prev.classList.contains('note-row')) {
                    row.parentNode.insertBefore(row, prev);
                }
            });
        });

        document.querySelectorAll('.reorder-down').forEach(btn => {
            btn.addEventListener('click', function() {
                const row = this.closest('.note-row');
                const next = row.nextElementSibling;
                if (next && next.classList.contains('note-row')) {
                    row.parentNode.insertBefore(next, row);
                }
            });
        });

        document.getElementById('saveReorderBtn').addEventListener('click', async function() {
            const noteIds = Array.from(noteContainer.querySelectorAll('.note-row'))
                .map(el => parseInt(el.dataset.noteId));

            await fetch('/Piles/SaveNoteOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pileId: reorderPileId, noteIds: noteIds })
            });

            window.location.href = `/Folders/Details/@Model.Id`;
        });
    </script>
}

@if (reorderMode)
{
    <script>
        function pileReorderHandler(direction) {
            return function() {
                const row = this.closest('.pile-row');
                const sibling = direction === 'up' ? row.previousElementSibling : row.nextElementSibling;
                if (sibling && sibling.classList.contains('pile-row')) {
                    if (direction === 'up') {
                        row.parentNode.insertBefore(row, sibling);
                    } else {
                        row.parentNode.insertBefore(sibling, row);
                    }
                }
            };
        }

        document.querySelectorAll('.pile-reorder-up').forEach(btn => btn.addEventListener('click', pileReorderHandler('up')));
        document.querySelectorAll('.pile-reorder-down').forEach(btn => btn.addEventListener('click', pileReorderHandler('down')));

        document.getElementById('savePileOrderBtn').addEventListener('click', async function() {
            const allPiles = Array.from(document.querySelectorAll('.pile-row'));
            const pileIds = allPiles.map(el => parseInt(el.dataset.pileId));

            await fetch('/Piles/SavePileOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: @Model.Id, pileIds: pileIds })
            });

            window.location.href = `/Folders/Details/@Model.Id`;
        });
    </script>
}
