@model List<NoteVault.ViewModels.FolderListViewModel>

@{
    ViewData["Title"] = "Folders";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Folders</h4>
        <a asp-action="Create" class="btn btn-primary">New Folder</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <p class="mb-2">No folders yet.</p>
            <a asp-action="Create">Create your first folder</a>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center py-2 px-3 text-muted small fw-bold text-uppercase" style="border: 1px solid #dee2e6;">
            <span class="me-3" style="font-size: 1.1rem; width: 23px;"></span>
            <span style="width: 160px;">Title</span>
            <span style="flex: 1; padding-right: 65px;">Description</span>
            <span style="flex: 0.5;">Notes/Piles</span>
            <span class="text-end" style="padding-right: 35px">Created</span>
        </div>
        <div class="card">
            <div class="list-group list-group-flush">
                @foreach (var folder in Model)
                {
                    
                        <!-- Folder icon, name and description -->
                        <a asp-action="Details" asp-route-id="@folder.Id" class="list-group-item list-group-item-action d-flex align-items-center py-3 text-decoration-none" style="flex: 2;">
                            <span class="me-3" style="font-size: 1.3rem;">📁</span>
                            <strong class="text-dark" style="width: 160px;">@folder.Name</strong>
                            <span class="text-muted text-truncate" style="flex: 1;">@(folder.Description ?? "")</span>
                            
                            <!-- Counts -->
                            <span class="text-muted" style="width: 275px;">
                                @folder.NoteCount @(folder.NoteCount == 1 ? "note" : "notes") · @folder.PileCount @(folder.PileCount == 1 ? "pile" : "piles")
                            </span>

                            <!-- Date -->
                            <span class="text-muted ms-3" style="width: 100px; text-align: right">
                                <partial name="_LocalDate" model="folder.CreatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })" />
                            </span>
                        </a>
                    
                }
            </div>
        </div>
    }
</div>

<!-- Delete Folder Modal -->
<div class="modal fade" id="deleteFolderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Folder</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>This action will move all the contents of <strong id="deleteFolderName"></strong> to the trash.</p>
                <p class="text-muted">Make sure to move or export any notes or piles you might need.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post" id="deleteFolderForm">
                    <input type="hidden" name="id" id="deleteFolderId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteFolder(id, name) {
        document.getElementById('deleteFolderId').value = id;
        document.getElementById('deleteFolderName').textContent = name;
    }
</script>
