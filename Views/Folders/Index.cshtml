@model List<NoteVault.ViewModels.FolderListViewModel>

@{
    ViewData["Title"] = "Folders";
    Layout = "_Layout";
}

<div class="folders-page">

    <div class="folders-header">
        <div class="folders-header-title">
            <div class="accent-bar"></div>
            <h1>Folders</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="inline-filter-wrap">
                <i class="bi bi-search inline-filter-icon"></i>
                <input type="text" id="folderFilter" class="inline-filter-input" placeholder="Filter folders..." autocomplete="off"/>
            </div>
            <button class="btn btn-pill btn-pill-primary" data-bs-toggle="modal" data-bs-target="#createFolderModal">
                <i class="bi bi-plus-lg"></i> New Folder
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="nv-alert alert alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill alert-icon"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-folder"></i>
            <p>No folders yet.</p>
            <button class="btn btn-pill btn-pill-outline mt-2" data-bs-toggle="modal" data-bs-target="#createFolderModal">
                Create your first folder
            </button>
        </div>
    }
    else
    {
        <div class="trash-list" id="foldersList">
            @foreach (var folder in Model)
            {
                <a asp-action="Details" asp-route-id="@folder.Id"
                   class="trash-row text-decoration-none folder-row">
                    <i class="bi bi-folder row-icon"></i>
                    <span class="row-title">@folder.Name</span>
                    @if (!string.IsNullOrEmpty(folder.Description))
                    {
                        <span class="folder-description">@folder.Description</span>
                    }
                    <span class="row-meta folder-counts">
                        @folder.NoteCount @(folder.NoteCount == 1 ? "note" : "notes") ·
                        @folder.PileCount @(folder.PileCount == 1 ? "pile" : "piles")
                    </span>
                    <span class="row-meta">
                        <partial name="_LocalDate" model="folder.CreatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                    </span>
                </a>
            }
        </div>

        <div class="empty-state" id="noFolderMatches" style="display: none;">
            <i class="bi bi-search"></i>
            <p>No folders match your search.</p>
        </div>
    }
</div>

<!-- Create Folder Modal -->
<div class="modal fade nv-modal" id="createFolderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-folder-plus"></i> New Folder
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post" class="nv-form">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control" required autofocus maxlength="100"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-muted" style="font-weight: normal; text-transform: none; letter-spacing: 0;">(optional)</span></label>
                        <textarea name="Description" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pill btn-pill-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .folders-page {
        max-width: 1100px;
        margin: 1rem auto;
        padding: 0 1.5rem;
    }
    .folders-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        gap: 1rem;
    }
    .folders-header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .folders-header .accent-bar {
        width: 4px;
        height: 36px;
        background: var(--brand-orange);
        border-radius: var(--radius-pill);
    }
    .folders-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
    }

    .folder-description {
        color: var(--text-secondary);
        font-size: 0.85rem;
        flex-grow: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
        padding-right: 1rem;
    }
    .folder-row .row-title {
        flex-grow: 0;
        flex-shrink: 0;
        margin-right: 1rem;
    }
    .folder-row:not(:has(.folder-description)) .row-title {
        flex-grow: 1;
    }
    .folder-counts {
        margin-right: 1rem;
    }
</style>

<script>
    (function() {
        const filterInput = document.getElementById('folderFilter');
        const foldersList = document.getElementById('foldersList');
        const noMatchesEl = document.getElementById('noFolderMatches');
        if (!filterInput || !foldersList) return;

        filterInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            const rows = foldersList.querySelectorAll('.folder-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const title = row.querySelector('.row-title').textContent.trim().toLowerCase();
                const desc = row.querySelector('.folder-description')?.textContent.trim().toLowerCase() || '';
                const match = title.includes(query) || desc.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            foldersList.style.display = visibleCount === 0 ? 'none' : '';
            noMatchesEl.style.display = visibleCount === 0 && rows.length > 0 ? 'block' : 'none';
        });
    })();
</script>
