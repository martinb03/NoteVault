<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NoteVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-light border-bottom box-shadow mb-3 d-flex justify-content-center align-items-center px-4" style="height: 75px; background-color: #FF8C42">
        <span class="navbar-brand mb-0 text-white" style="font-size: 35px; font-weight: bold; text-shadow: 0 1px 3px black">NoteVault</span>
    </nav>
</header>
<main role="main" class="pb-3">
    @RenderBody()
</main>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>