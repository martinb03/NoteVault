@using NoteVault.ViewModels
@{
    var items = ViewData["Breadcrumb"] as List<BreadcrumbItem> ?? new List<BreadcrumbItem>();
}
@if (items.Any())
{
    <nav class="nv-breadcrumb-wrap" aria-label="breadcrumb">
        <div class="nv-breadcrumb">
            @for (int i = 0; i < items.Count; i++)
            {
                var item = items[i];
                var isLast = i == items.Count - 1;
                var displayText = item.Text.Length > 30 ? item.Text.Substring(0, 30) + "…" : item.Text;

                if (isLast || string.IsNullOrEmpty(item.Url))
                {
                    <span class="nv-crumb current" title="@item.Text">@displayText</span>
                }
                else
                {
                    <a href="@item.Url" class="nv-crumb" title="@item.Text">@displayText</a>
                }

                if (!isLast)
                {
                    <i class="bi bi-caret-right-fill nv-crumb-sep"></i>
                }
            }
        </div>
    </nav>
}