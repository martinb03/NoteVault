@using NoteVault.ViewModels
@{
    var items = ViewData["Breadcrumb"] as List<BreadcrumbItem> ?? new List<BreadcrumbItem>();
}

@if (items.Any())
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            @for (int i = 0; i < items.Count; i++)
            {
                var item = items[i];
                var isLast = i == items.Count - 1;

                if (isLast)
                {
                    <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="@item.Url" class="text-decoration-none">@item.Text</a></li>
                }
            }
        </ol>
    </nav>
}