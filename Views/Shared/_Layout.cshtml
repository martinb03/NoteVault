<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - NoteVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/NoteVault.styles.css" asp-append-version="true"/>
</head>
<body><!-- style="font-family: 'Adwaita Mono'"-->
<header >
    <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow mb-3 d-flex justify-content-between align-items-center px-5" style="height: 75px; background-color: #FF8C42">
        <div style="flex: 1;">
            <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">
                <!-- <img class="logo-image", src=""/>-->
                <span class="logo-text" style="font-size:30px ; font-weight: bold; text-shadow: 0 0 2px black;" >NoteVault</span>
            </a>
        </div>
        <form method="GET" class="mx-auto" role="search" action="http://localhost:8080">
            <input type="text" class="form-control rounded-pill" placeholder="Search..." style="width: 300px; font-size: 15px" />
        </form>
        <div style="flex:1;" class="d-flex justify-content-end" >
            <ul class="navbar-nav flex-row gap-1" style="text-shadow: 0 0 1px black; font-weight: bold">
                <li class="nav-item">
                    <a class="nav-link text-white" style="width: 90px; text-align: center" asp-area="" asp-controller="Folders" asp-action="Index">Folders</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" style="width: 90px; text-align: center" asp-area="" asp-controller="Notes" asp-action="Index">Notes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" style="width: 90px; text-align: center" asp-area="" asp-controller="Home" asp-action="Tags">Tags</a>
                </li>
                <li class="nav-item">
                    <div class="dropdown ms-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link dropdown-toggle text-white" style="width: 90px; text-align: center" href="#" role="button" data-bs-toggle="dropdown">
                                @User.FindFirst("DisplayName")?.Value
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Settings" asp-action="Index">Settings</a>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        }
                    </div>
                </li>
            </ul>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

<script>
    document.querySelectorAll('.local-date').forEach(el => {
        const utc = new Date(el.dataset.utc);
        const format = el.dataset.format;
        const day = String(utc.getDate()).padStart(2, '0');
        const month = String(utc.getMonth() + 1).padStart(2, '0');
        const year = utc.getFullYear();
        const hours = String(utc.getHours()).padStart(2, '0');
        const minutes = String(utc.getMinutes()).padStart(2, '0');
        el.textContent = format === 'date'
            ? `${day}/${month}/${year}`
            : `${hours}:${minutes} - ${day}/${month}/${year}`;
    });
</script>
</body>
</html>