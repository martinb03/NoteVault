<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - NoteVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/NoteVault.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script>
    // Apply theme
    (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
    })();
</script>
</head>

<style>
    #searchBar:focus-within {
        box-shadow: 0 0 0 2px rgba(255, 140, 66, 0.4);
    }
    .search-chip {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 500;
        border: 1px solid;
        cursor: pointer;
        transition: opacity 0.15s;
    }
    .search-chip:hover { opacity: 0.7; }
    .search-chip .chip-close { margin-left: 4px; font-weight: bold; }
    .search-chip-folder {
        background-color: #FFF3CD;
        border-color: #FFC107;
        color: #856404;
    }
    .filter-tag-chip.selected {
        outline: 2px solid var(--brand-orange);
        outline-offset: 1px;
    }
    
    .search-result-item:last-child { border-bottom: none; }
   
    .search-result-snippet b, .search-result-title b { background-color: #FFF3CD; font-weight: 600; }
</style>

<body style="padding-top: 72px">
<header >
    <nav class="navbar navbar-expand-lg nv-navbar fixed-top">
        <div class="container-fluid px-4">
     
            <!-- Brand: icon + wordmark -->
            <a class="navbar-brand nv-brand d-flex align-items-center gap-2"
               asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-journal-bookmark-fill"></i>
                <span>NoteVault</span>
            </a>
     
            <!-- Search bar (centered) -->
            <div class="nv-search-wrap">
                <div id="searchBar" class="nv-searchbar d-flex align-items-center">
                    <i class="bi bi-search nv-search-icon"></i>
     
                    <div id="filterChips" class="d-flex align-items-center" style="gap: 4px; flex-wrap: wrap;"></div>
     
                    <input type="text" id="searchInput" class="nv-search-input flex-grow-1"
                           placeholder="Search..." autocomplete="off"/>
     
                    <button type="button" id="filterBtn" class="btn btn-link p-0 nv-search-filter"
                            data-bs-toggle="modal" data-bs-target="#searchFilterModal" title="Filter">
                        <i class="bi bi-sliders"></i>
                    </button>
                </div>
     
                <div id="searchDropdown" class="position-absolute rounded shadow d-none"
                     style="top: 100%; left: 0; right: 0; margin-top: 4px; z-index: 1050; max-height: 400px; overflow-y: auto;">
                </div>
            </div>
     
            <!-- Nav links + user -->
            <ul class="navbar-nav nv-nav-links d-flex align-items-center gap-1">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }
                <li class="nav-item">
                    <a asp-controller="Folders" asp-action="Index"
                       class="nav-link nv-link @(currentController == "Folders" ? "active" : "")">Folders</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Notes" asp-action="Index"
                       class="nav-link nv-link @(currentController == "Notes" ? "active" : "")">Notes</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Tags" asp-action="Index"
                       class="nav-link nv-link @(currentController == "Tags" ? "active" : "")">Tags</a>
                </li>
     
                <!-- User dropdown -->
                <li class="nav-item dropdown ms-2">
                    <a class="nav-link nv-link nv-user d-flex align-items-center gap-2"
                       data-bs-toggle="dropdown" href="#">
                        <i class="bi bi-person-circle"></i>
                        <span>@User.FindFirst("DisplayName")?.Value</span>
                        <i class="bi bi-chevron-down nv-user-chev"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end nv-dropdown">
                        <li>
                            <a class="dropdown-item nv-dropdown-item" asp-controller="Settings" asp-action="Index">
                                <i class="bi bi-gear"></i> Settings
                            </a>
                        </li>
                        <li>
                            <button class="dropdown-item nv-dropdown-item" id="themeToggle">
                                <i class="bi bi-moon" id="themeToggleIcon"></i>
                                <span id="themeToggleLabel">Dark mode</span>
                            </button>
                        </li>
                        <li>
                            <a class="dropdown-item nv-dropdown-item" asp-controller="Trash" asp-action="Index">
                                <i class="bi bi-trash"></i> Trash
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item nv-dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
     
        </div>
    </nav>
</header>

<!-- Filter Modal -->
<div class="modal fade" id="searchFilterModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-sliders me-2" style="color: var(--brand-orange);"></i>
                    Filter search
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
 
                <div class="filter-section">
                    <div class="filter-label">
                        <i class="bi bi-folder"></i> Folder
                    </div>
                    <select id="filterFolderSelect" class="form-select">
                        <option value="">Any folder</option>
                    </select>
                </div>
 
                <div class="filter-section">
                    <div class="filter-label">
                        <i class="bi bi-tags"></i> Tags
                    </div>
                    <div id="filterTagsContainer"></div>
                </div>
 
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="applyFilterBtn" class="btn btn-pill btn-pill-primary">Apply</button>
            </div>
        </div>
    </div>
</div>

<main role="main" class="pb-3">
        @RenderBody()
    </main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

<script>
    document.querySelectorAll('.local-date').forEach(el => {
        const utc = new Date(el.dataset.utc);
        const format = el.dataset.format;
        const day = String(utc.getDate()).padStart(2, '0');
        const month = String(utc.getMonth() + 1).padStart(2, '0');
        const year = utc.getFullYear();
        const hours = String(utc.getHours()).padStart(2, '0');
        const minutes = String(utc.getMinutes()).padStart(2, '0');
        el.textContent = format === 'date'
            ? `${day}/${month}/${year}`
            : `${hours}:${minutes} - ${day}/${month}/${year}`;
    });
</script>
<script>
(function() {
    const searchInput = document.getElementById('searchInput');
    const searchDropdown = document.getElementById('searchDropdown');
    const filterChips = document.getElementById('filterChips');
    const filterFolderSelect = document.getElementById('filterFolderSelect');
    const filterTagsContainer = document.getElementById('filterTagsContainer');
    const applyFilterBtn = document.getElementById('applyFilterBtn');
 
    let activeFolderId = null;
    let activeFolderName = null;
    let activeTagIds = new Set();
    let activeTagsMap = new Map(); // id -> {name, color}
    let availableFolders = [];
    let availableTags = [];
    let searchTimeout = null;
 
    //Fetch folders and tags for the filter modal
    async function loadFilterOptions() {
        if (availableFolders.length === 0) {
            const fRes = await fetch('/Folders/ListJson');
            if (fRes.ok) availableFolders = await fRes.json();
        }
        if (availableTags.length === 0) {
            const tRes = await fetch('/Tags/ListJson');
            if (tRes.ok) availableTags = await tRes.json();
        }
    }
 
    //Render the filter modal contents
    function populateFilterModal() {
        filterFolderSelect.innerHTML = '<option value="">Any folder</option>' +
            availableFolders.map(f => `<option value="${f.id}" ${f.id === activeFolderId ? 'selected' : ''}>${escapeHtml(f.name)}</option>`).join('');
 
        filterTagsContainer.innerHTML = availableTags.map(t => {
            const selected = activeTagIds.has(t.id) ? 'selected' : '';
            const color = t.color || '#868E96';
            return `<div class="filter-tag-chip ${selected}" data-tag-id="${t.id}" data-tag-name="${escapeHtml(t.name)}" data-tag-color="${color}"
                         style="border-color: ${color}; background-color: ${color}33;">${escapeHtml(t.name)}</div>`;
        }).join('');
 
        filterTagsContainer.querySelectorAll('.filter-tag-chip').forEach(chip => {
            chip.addEventListener('click', function() {
                this.classList.toggle('selected');
            });
        });
    }
 
    document.getElementById('filterBtn').addEventListener('click', async function() {
        await loadFilterOptions();
        populateFilterModal();
    });
 
    //Apply filters from modal
    applyFilterBtn.addEventListener('click', function() {
        const folderId = filterFolderSelect.value;
        if (folderId) {
            activeFolderId = parseInt(folderId);
            activeFolderName = availableFolders.find(f => f.id === activeFolderId)?.name || '';
        } else {
            activeFolderId = null;
            activeFolderName = null;
        }
 
        activeTagIds.clear();
        activeTagsMap.clear();
        filterTagsContainer.querySelectorAll('.filter-tag-chip.selected').forEach(chip => {
            const id = parseInt(chip.dataset.tagId);
            activeTagIds.add(id);
            activeTagsMap.set(id, { name: chip.dataset.tagName, color: chip.dataset.tagColor });
        });
 
        renderChips();
        runSearch();
        bootstrap.Modal.getInstance(document.getElementById('searchFilterModal')).hide();
    });

    function renderDropdown(results) {
        const q = searchInput.value.trim();
        const seeAllParams = new URLSearchParams();
        if (q) seeAllParams.set('q', q);
        activeTagIds.forEach(id => seeAllParams.append('tagIds', id));
        if (activeFolderId !== null) seeAllParams.set('folderId', activeFolderId);
        const seeAllUrl = `/Search/Results?${seeAllParams.toString()}`;

        if (results.length === 0) {
            searchDropdown.innerHTML = `
            <div class="search-empty">No results</div>
            <a href="${seeAllUrl}" class="search-result-see-all">See all results <i class="bi bi-arrow-right"></i></a>
        `;
            searchDropdown.classList.remove('d-none');
            return;
        }

        searchDropdown.innerHTML = results.map(r => `
        <a href="/Notes/Details/${r.id}?from=search" class="search-result-item">
            ${r.folderName ? `<div class="search-result-folder"><i class="bi bi-folder"></i> ${escapeHtml(r.folderName)}</div>` : ''}
            <div class="search-result-title">${stripBold(r.titleHighlight)}</div>
            <div class="search-result-snippet">${stripBold(r.snippet)}</div>
        </a>
    `).join('') + `<a href="${seeAllUrl}" class="search-result-see-all">See all results <i class="bi bi-arrow-right"></i></a>`;
        searchDropdown.classList.remove('d-none');
    }
    
    function renderChips() {
        filterChips.innerHTML = '';

        if (activeFolderId !== null) {
            const chip = document.createElement('span');
            chip.className = 'search-chip search-chip-folder';
            chip.innerHTML = `<i class="bi bi-folder"></i> ${escapeHtml(activeFolderName)}<span class="chip-close"><i class="bi bi-x"></i></span>`;
            chip.addEventListener('click', function() {
                activeFolderId = null;
                activeFolderName = null;
                renderChips();
                runSearch();
            });
            filterChips.appendChild(chip);
        }

        activeTagsMap.forEach((info, id) => {
            const chip = document.createElement('span');
            chip.className = 'search-chip';
            chip.style.borderColor = info.color;
            chip.style.backgroundColor = info.color + '33';
            chip.innerHTML = `${escapeHtml(info.name)}<span class="chip-close"><i class="bi bi-x"></i></span>`;
            chip.addEventListener('click', function() {
                activeTagIds.delete(id);
                activeTagsMap.delete(id);
                renderChips();
                runSearch();
            });
            filterChips.appendChild(chip);
        });
    }

    async function runSearch() {
        const q = searchInput.value.trim();
        const hasFilters = activeTagIds.size > 0 || activeFolderId !== null;

        // Nothing entered or selected — hide dropdown
        if (!q && !hasFilters) {
            searchDropdown.classList.add('d-none');
            return;
        }

        // Filters only, no text — show just the "See all results" link
        if (!q) {
            renderFilterOnlyDropdown();
            return;
        }

        // Normal text-based search
        const params = new URLSearchParams();
        params.set('q', q);
        activeTagIds.forEach(id => params.append('tagIds', id));
        if (activeFolderId !== null) params.set('folderId', activeFolderId);

        try {
            const res = await fetch(`/Search/LiveSearch?${params.toString()}`);
            if (!res.ok) return;
            const results = await res.json();
            renderDropdown(results);
        } catch (e) {
            console.error('Search failed', e);
        }
    }

    function renderFilterOnlyDropdown() {
        const seeAllParams = new URLSearchParams();
        activeTagIds.forEach(id => seeAllParams.append('tagIds', id));
        if (activeFolderId !== null) seeAllParams.set('folderId', activeFolderId);
        const seeAllUrl = `/Search/Results?${seeAllParams.toString()}`;

        searchDropdown.innerHTML = `
        <div class="search-empty">Type to search, or jump straight to filtered results</div>
        <a href="${seeAllUrl}" class="search-result-see-all">See all results <i class="bi bi-arrow-right"></i></a>
    `;
        searchDropdown.classList.remove('d-none');
    }

   
 
    //Debounced search on typing
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(runSearch, 300);
    });
 
    //Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
        const filterModal = document.getElementById('searchFilterModal');
        if (!searchDropdown.contains(e.target)
            && !document.getElementById('searchBar').contains(e.target)
            && !(filterModal && filterModal.contains(e.target))) {
            searchDropdown.classList.add('d-none');
        }
    });
 
    //Reopen dropdown on focus if there's text
    searchInput.addEventListener('focus', function() {
        if (searchInput.value.trim() && searchDropdown.innerHTML.trim()) {
            searchDropdown.classList.remove('d-none');
        }
    });

    function stripBold(s) {
        return String(s).replace(/<\/?b>/g, '');
    }
    
    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
})();

const toggle = document.getElementById('themeToggle');
const icon = document.getElementById('themeToggleIcon');
const label = document.getElementById('themeToggleLabel');

function updateThemeUI(theme) {
    icon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon';
    label.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
}

updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

toggle?.addEventListener('click', function() {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeUI(next);
});
</script>
</body>
</html>