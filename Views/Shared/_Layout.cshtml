<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - NoteVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/NoteVault.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<style>
    #searchBar:focus-within {
        box-shadow: 0 0 0 2px rgba(255, 140, 66, 0.4);
    }
    .search-chip {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 500;
        border: 1px solid;
        cursor: pointer;
        transition: opacity 0.15s;
    }
    .search-chip:hover { opacity: 0.7; }
    .search-chip .chip-close { margin-left: 4px; font-weight: bold; }
    .search-chip-folder {
        background-color: #FFF3CD;
        border-color: #FFC107;
        color: #856404;
    }
    .filter-tag-chip {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1.5px solid;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        color: #333;
    }
    .filter-tag-chip.selected {
        outline: 3px solid #FF8C42;
        outline-offset: 2px;
    }
    .search-result-item {
        padding: 10px 14px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: background-color 0.15s;
    }
    .search-result-item:hover { background-color: #f8f9fa; color: inherit; }
    .search-result-item:last-child { border-bottom: none; }
    .search-result-title { font-weight: 600; color: #212529; }
    .search-result-folder { font-size: 0.75rem; color: #6c757d; float: right; }
    .search-result-snippet { font-size: 0.85rem; color: #495057; margin-top: 4px; 
        overflow: hidden; 
        text-overflow: ellipsis;
        white-space: nowrap;
        padding-right: 12px; }
    .search-result-snippet b, .search-result-title b { background-color: #FFF3CD; font-weight: 600; }
</style>

<body><!-- style="font-family: 'Adwaita Mono'"-->
<header >
    <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow mb-3 d-flex justify-content-between align-items-center px-5" style="height: 75px;"> <!--#FF8C42-->
        <div style="flex: 1;">
            <a class="navbar-brand text-white" asp-area="" asp-controller="Dashboard" asp-action="Index">
                <!-- <img class="logo-image", src=""/>-->
                <span class="logo-text" style="font-size:30px ; font-weight: bold; text-shadow: 0 0 2px black;" >NoteVault</span>
            </a>
        </div>
        
        
        <div class="position-relative mx-auto" style="width: 450px;">
            <div id="searchBar" class="d-flex align-items-center bg-white rounded-pill px-2"
            style="min-height: 38px; flex-wrap: wrap; gap: 4px; padding-top: 4px; padding-bottom: 4px;">
 
                <!-- Filter chips container - chips get added here dynamically -->
                <div id="filterChips" class="d-flex align-items-center" style="gap: 4px; flex-wrap: wrap;"></div>
 
                <!-- Text input -->
                <input type="text" id="searchInput" class="border-0 flex-grow-1"
                    placeholder="Search..." autocomplete="off"
                    style="font-size: 15px; min-width: 100px; outline: none; background: transparent;"/>
 
                <!-- Filter button -->
                <button type="button" id="filterBtn" class="btn btn-link p-0 text-muted"
                        data-bs-toggle="modal" data-bs-target="#searchFilterModal"
                        style="font-size: 1rem;" title="Filter">
                    ⚙
                </button>
            </div>
 
            <!-- Live results dropdown -->
            <div id="searchDropdown" class="position-absolute bg-white rounded shadow d-none"
            style="top: 100%; left: 0; right: 0; margin-top: 4px; z-index: 1050; max-height: 400px; overflow-y: auto;">
            </div>
        </div>
        
        <div style="flex:1;" class="d-flex justify-content-end" >
            <ul class="navbar-nav flex-row gap-1" style="text-shadow: 0 0 1px black; font-weight: bold">
                <li class="nav-item">
                    <a class="nav-link text-white" style="width: 90px; text-align: center" asp-area="" asp-controller="Folders" asp-action="Index">Folders</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" style="width: 90px; text-align: center" asp-area="" asp-controller="Notes" asp-action="Index">Notes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" style="width: 90px; text-align: center" asp-area="" asp-controller="Tags" asp-action="Index">Tags</a>
                </li>
                <li class="nav-item">
                    <div class="dropdown ms-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link dropdown-toggle text-white" style="width: 90px; text-align: center" href="#" role="button" data-bs-toggle="dropdown">
                                @User.FindFirst("DisplayName")?.Value
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Settings" asp-action="Index">Settings</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Trash" asp-action="Index">Trash</a>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        }
                    </div>
                </li>
            </ul>
        </div>
    </nav>
</header>

<!-- Filter Modal -->
<div class="modal fade" id="searchFilterModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Folder</label>
                    <select id="filterFolderSelect" class="form-select">
                        <option value="">Any folder</option>
                        <!-- Folders populated by JS on modal open -->
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tags</label>
                    <div id="filterTagsContainer" class="d-flex flex-wrap gap-2">
                        <!-- Tag chips populated by JS on modal open -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="applyFilterBtn">Apply</button>
            </div>
        </div>
    </div>
</div>

<main role="main" class="pb-3">
        @RenderBody()
    </main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

<script>
    document.querySelectorAll('.local-date').forEach(el => {
        const utc = new Date(el.dataset.utc);
        const format = el.dataset.format;
        const day = String(utc.getDate()).padStart(2, '0');
        const month = String(utc.getMonth() + 1).padStart(2, '0');
        const year = utc.getFullYear();
        const hours = String(utc.getHours()).padStart(2, '0');
        const minutes = String(utc.getMinutes()).padStart(2, '0');
        el.textContent = format === 'date'
            ? `${day}/${month}/${year}`
            : `${hours}:${minutes} - ${day}/${month}/${year}`;
    });
</script>
<script>
(function() {
    const searchInput = document.getElementById('searchInput');
    const searchDropdown = document.getElementById('searchDropdown');
    const filterChips = document.getElementById('filterChips');
    const filterFolderSelect = document.getElementById('filterFolderSelect');
    const filterTagsContainer = document.getElementById('filterTagsContainer');
    const applyFilterBtn = document.getElementById('applyFilterBtn');
 
    let activeFolderId = null;
    let activeFolderName = null;
    let activeTagIds = new Set();
    let activeTagsMap = new Map(); // id -> {name, color}
    let availableFolders = [];
    let availableTags = [];
    let searchTimeout = null;
 
    // ── Fetch folders and tags for the filter modal ──
    async function loadFilterOptions() {
        if (availableFolders.length === 0) {
            const fRes = await fetch('/Folders/ListJson');
            if (fRes.ok) availableFolders = await fRes.json();
        }
        if (availableTags.length === 0) {
            const tRes = await fetch('/Tags/ListJson');
            if (tRes.ok) availableTags = await tRes.json();
        }
    }
 
    // ── Render the filter modal contents ──
    function populateFilterModal() {
        filterFolderSelect.innerHTML = '<option value="">Any folder</option>' +
            availableFolders.map(f => `<option value="${f.id}" ${f.id === activeFolderId ? 'selected' : ''}>${escapeHtml(f.name)}</option>`).join('');
 
        filterTagsContainer.innerHTML = availableTags.map(t => {
            const selected = activeTagIds.has(t.id) ? 'selected' : '';
            const color = t.color || '#868E96';
            return `<div class="filter-tag-chip ${selected}" data-tag-id="${t.id}" data-tag-name="${escapeHtml(t.name)}" data-tag-color="${color}"
                         style="border-color: ${color}; background-color: ${color}33;">${escapeHtml(t.name)}</div>`;
        }).join('');
 
        filterTagsContainer.querySelectorAll('.filter-tag-chip').forEach(chip => {
            chip.addEventListener('click', function() {
                this.classList.toggle('selected');
            });
        });
    }
 
    document.getElementById('filterBtn').addEventListener('click', async function() {
        await loadFilterOptions();
        populateFilterModal();
    });
 
    // ── Apply filters from modal ──
    applyFilterBtn.addEventListener('click', function() {
        const folderId = filterFolderSelect.value;
        if (folderId) {
            activeFolderId = parseInt(folderId);
            activeFolderName = availableFolders.find(f => f.id === activeFolderId)?.name || '';
        } else {
            activeFolderId = null;
            activeFolderName = null;
        }
 
        activeTagIds.clear();
        activeTagsMap.clear();
        filterTagsContainer.querySelectorAll('.filter-tag-chip.selected').forEach(chip => {
            const id = parseInt(chip.dataset.tagId);
            activeTagIds.add(id);
            activeTagsMap.set(id, { name: chip.dataset.tagName, color: chip.dataset.tagColor });
        });
 
        renderChips();
        runSearch();
        bootstrap.Modal.getInstance(document.getElementById('searchFilterModal')).hide();
    });
 
    // ── Render chips in the search bar ──
    function renderChips() {
        filterChips.innerHTML = '';
 
        if (activeFolderId !== null) {
            const chip = document.createElement('span');
            chip.className = 'search-chip search-chip-folder';
            chip.innerHTML = `📁 ${escapeHtml(activeFolderName)}<span class="chip-close">✕</span>`;
            chip.addEventListener('click', function() {
                activeFolderId = null;
                activeFolderName = null;
                renderChips();
                runSearch();
            });
            filterChips.appendChild(chip);
        }
 
        activeTagsMap.forEach((info, id) => {
            const chip = document.createElement('span');
            chip.className = 'search-chip';
            chip.style.borderColor = info.color;
            chip.style.backgroundColor = info.color + '33';
            chip.style.color = '#333';
            chip.innerHTML = `${escapeHtml(info.name)}<span class="chip-close">✕</span>`;
            chip.addEventListener('click', function() {
                activeTagIds.delete(id);
                activeTagsMap.delete(id);
                renderChips();
                runSearch();
            });
            filterChips.appendChild(chip);
        });
    }
 
    // ── Run the search ──
    async function runSearch() {
        const q = searchInput.value.trim();
        if (!q && activeTagIds.size === 0 && activeFolderId === null) {
            searchDropdown.classList.add('d-none');
            return;
        }
        if (!q) {
            searchDropdown.classList.add('d-none');
            return;
        }
 
        const params = new URLSearchParams();
        params.set('q', q);
        activeTagIds.forEach(id => params.append('tagIds', id));
        if (activeFolderId !== null) params.set('folderId', activeFolderId);
 
        try {
            const res = await fetch(`/Search/LiveSearch?${params.toString()}`);
            if (!res.ok) return;
            const results = await res.json();
            renderDropdown(results);
        } catch (e) {
            console.error('Search failed', e);
        }
    }

    function renderDropdown(results) {
        const q = searchInput.value.trim();
        const seeAllParams = new URLSearchParams();
        if (q) seeAllParams.set('q', q);
        activeTagIds.forEach(id => seeAllParams.append('tagIds', id));
        if (activeFolderId !== null) seeAllParams.set('folderId', activeFolderId);
        const seeAllUrl = `/Search/Results?${seeAllParams.toString()}`;

        if (results.length === 0) {
            searchDropdown.innerHTML = `
            <div class="p-3 text-muted text-center">No results</div>
            <a href="${seeAllUrl}" class="d-block text-center py-2 small text-decoration-none" style="border-top: 1px solid #eee;">See all results →</a>
        `;
            searchDropdown.classList.remove('d-none');
            return;
        }

        searchDropdown.innerHTML = results.map(r => `
        <a href="/Notes/Details/${r.id}?from=search" class="search-result-item">
            ${r.folderName ? `<span class="search-result-folder">📁 ${escapeHtml(r.folderName)}</span>` : ''}
            <div class="search-result-title">${stripBold(r.titleHighlight)}</div>
            <div class="search-result-snippet">${stripBold(r.snippet)}</div>
        </a>
    `).join('') + `<a href="${seeAllUrl}" class="d-block text-center py-2 small text-decoration-none" style="border-top: 1px solid #eee;">See all results →</a>`;
        searchDropdown.classList.remove('d-none');
    }
 
    // ── Debounced search on typing ──
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(runSearch, 300);
    });
 
    // ── Close dropdown when clicking outside ──
    document.addEventListener('click', function(e) {
        if (!searchDropdown.contains(e.target) && !document.getElementById('searchBar').contains(e.target)) {
            searchDropdown.classList.add('d-none');
        }
    });
 
    // ── Reopen dropdown on focus if there's text ──
    searchInput.addEventListener('focus', function() {
        if (searchInput.value.trim() && searchDropdown.innerHTML.trim()) {
            searchDropdown.classList.remove('d-none');
        }
    });

    function stripBold(s) {
        return String(s).replace(/<\/?b>/g, '');
    }
    
    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
})();
</script>
</body>
</html>