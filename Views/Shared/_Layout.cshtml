<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - NoteVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/DocVault.styles.css" asp-append-version="true"/>
</head>
<body><!-- style="font-family: 'Adwaita Mono'"-->
<header >
    <nav class="avbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3 d-flex justify-content-between align-items-center px-5" style="height: 75px">
        <div style="flex: 1;">
            <a class="navbar-brand text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                <!-- <img class="logo-image", src=""/>-->
                <span class="logo-text" style="font-size:30px ; font-weight: bold">NoteVault</span>
            </a>
        </div>
        <form method="GET" class="mx-auto" role="search" action="http://localhost:8080">
            <input type="text" class="form-control rounded-pill" placeholder="Search..." style="width: 300px; font-size: 15px" />
        </form>
        <div style="flex:1;" class="d-flex justify-content-end" >
            <ul class="navbar-nav flex-row gap-3">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Folders">Folders</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Notes">Notes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Tags">Tags</a>
                </li>
            </ul>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>