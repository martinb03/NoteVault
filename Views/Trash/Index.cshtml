@using NoteVault.ViewModels
@model NoteVault.ViewModels.TrashViewModel

@{
ViewData["Title"] = "Trash";
Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 1100px;">

    <h4 class="mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-trash" style="color: var(--brand-orange);"></i>
        Trash
    </h4>

    @if (TempData["Success"] != null)
    {
    <div class="nv-alert alert-dismissible fade show">
        <i class="bi bi-check-circle-fill alert-icon"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    <!-- Tab nav -->
    <div class="nv-tabs">
        <a class="nv-tab @(Model.Tab == "folders" ? "active" : "")" asp-action="Index" asp-route-tab="folders">
            Folders <span class="tab-count">(@Model.Folders.Count)</span>
        </a>
        <a class="nv-tab @(Model.Tab == "piles" ? "active" : "")" asp-action="Index" asp-route-tab="piles">
            Piles <span class="tab-count">(@Model.Piles.Count)</span>
        </a>
        <a class="nv-tab @(Model.Tab == "notes" ? "active" : "")" asp-action="Index" asp-route-tab="notes">
            Notes <span class="tab-count">(@Model.Notes.Count)</span>
        </a>
    </div>

    <!-- Action bar -->
    <div class="action-bar">
        <input type="checkbox" id="selectAll" class="form-check-input"/>
        <label for="selectAll" class="select-all-label">Select all</label>
        <div class="ms-auto d-flex gap-2">
            <button type="button" id="restoreBtn" class="btn btn-pill btn-pill-outline" disabled>
                <i class="bi bi-arrow-counterclockwise"></i> Restore
            </button>
            <button type="button" id="deleteBtn" class="btn btn-pill btn-pill-danger" disabled
                    data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                <i class="bi bi-trash"></i> Delete permanently
            </button>
        </div>
    </div>

    <!-- Forms used for submission (populated by JS before submit) -->
    <form id="restoreForm" asp-action="Restore" method="post">
        <input type="hidden" name="tab" value="@Model.Tab"/>
    </form>
    <form id="deleteForm" asp-action="DeletePermanent" method="post">
        <input type="hidden" name="tab" value="@Model.Tab"/>
    </form>

    <!-- Tab content -->
    <div class="trash-list">
        @if (Model.Tab == "folders")
        {
        @if (Model.Folders.Count == 0)
        {
        <div class="empty-state">
            <i class="bi bi-folder2-open"></i>
            <p>No folders in trash.</p>
        </div>
        }
        else
        {
        @foreach (var f in Model.Folders)
        {
        var hasContents = f.Piles.Any() || f.Notes.Any();

        <div class="trash-folder-block">
            <div class="trash-folder-header">
                <input type="checkbox" class="form-check-input item-cb folder-cb"
                       data-id="@f.Id" data-type="folder" data-folder-id="@f.Id"/>
                @if (hasContents)
                {
                <button type="button" class="trash-folder-toggle collapsed"
                        data-bs-toggle="collapse" data-bs-target="#folder-@f.Id"
                        aria-expanded="false">
                    <i class="bi bi-chevron-right folder-chevron"></i>
                    <i class="bi bi-folder row-icon"></i>
                    <span class="row-title">@f.Name</span>
                    <span class="row-meta">
                                        @f.Piles.Count piles · @f.Notes.Count notes
                                        ·
                                        <partial name="_LocalDate" model="f.DeletedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                                    </span>
                </button>
                }
                else
                {
                <div class="trash-folder-toggle" style="cursor: default;">
                    <i class="bi bi-chevron-right folder-chevron" style="visibility: hidden;"></i>
                    <i class="bi bi-folder row-icon"></i>
                    <span class="row-title">@f.Name</span>
                    <span class="row-meta">
                                        empty
                                        ·
                                        <partial name="_LocalDate" model="f.DeletedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                                    </span>
                </div>
                }
            </div>

            @if (hasContents)
            {
            <div class="collapse" id="folder-@f.Id">
                <div class="folder-contents">
                    @foreach (var p in f.Piles)
                    {
                    <div class="folder-content-row">
                        <input type="checkbox" class="form-check-input item-cb child-cb"
                               data-id="@p.Id" data-type="pile" data-folder-id="@f.Id"/>
                        @if (string.IsNullOrEmpty(p.Icon))
                        {
                        <i class="bi bi-collection row-icon"></i>
                        }
                        else
                        {
                        <span style="font-size: 0.95rem;">@p.Icon</span>
                        }
                        <span class="row-title">@p.Name</span>
                    </div>
                    }
                    @foreach (var n in f.Notes)
                    {
                    <div class="folder-content-row">
                        <input type="checkbox" class="form-check-input item-cb child-cb"
                               data-id="@n.Id" data-type="note" data-folder-id="@f.Id"/>
                        <i class="bi bi-journal-text row-icon"></i>
                        <span class="row-title">@n.Title</span>
                    </div>
                    }
                </div>
            </div>
            }
        </div>
        }
        }
        }
        else if (Model.Tab == "piles")
        {
        @if (Model.Piles.Count == 0)
        {
        <div class="empty-state">
            <i class="bi bi-collection"></i>
            <p>No piles in trash.</p>
        </div>
        }
        else
        {
        @foreach (var p in Model.Piles)
        {
        <div class="trash-row @(p.ParentFolderDeleted ? "greyed" : "")"
             style="@(p.Color != null ? $"border-left: 4px solid {p.Color};" : "")">
            <input type="checkbox" class="form-check-input item-cb"
                   data-id="@p.Id" data-type="pile"
                   @(p.ParentFolderDeleted ? "disabled" : "")/>
            @if (string.IsNullOrEmpty(p.Icon))
            {
            <i class="bi bi-collection row-icon"></i>
            }
            else
            {
            <span style="font-size: 1rem;">@p.Icon</span>
            }
            <span class="row-title">@p.Name</span>
            @if (p.FolderName != null)
            {
            <span class="row-parent">
                                <i class="bi bi-folder"></i> @p.FolderName
                            </span>
            }
            @if (p.ParentFolderDeleted)
            {
            <span class="row-warning">
                                <i class="bi bi-exclamation-circle"></i> parent folder is also in trash
                            </span>
            }
            <span class="row-meta ms-auto">
                            <partial name="_LocalDate" model="p.DeletedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                        </span>
        </div>
        }
        }
        }
        else if (Model.Tab == "notes")
        {
        @if (Model.Notes.Count == 0)
        {
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <p>No notes in trash.</p>
        </div>
        }
        else
        {
        @foreach (var n in Model.Notes)
        {
        <div class="trash-row">
            <input type="checkbox" class="form-check-input item-cb"
                   data-id="@n.Id" data-type="note"/>
            <i class="bi bi-journal-text row-icon"></i>
            <span class="row-title">@n.Title</span>
            @if (n.FolderName != null)
            {
            <span class="row-parent">
                                <i class="bi bi-folder"></i> @n.FolderName
                            </span>
            }
            else
            {
            <span class="row-parent">Unfiled</span>
            }
            <span class="row-meta ms-auto">
                            <partial name="_LocalDate" model="n.DeletedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                        </span>
        </div>
        }
        }
        }
    </div>
</div>

<!-- Confirm Permanent Delete Modal -->
<div class="modal fade nv-modal" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i>
                    Permanently Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Permanently delete <strong id="deleteCount">0</strong> selected item(s)?</p>
                <p class="text-muted small">This cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-pill btn-pill-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Partial Restore Warning Modal -->
<div class="modal fade nv-modal" id="partialRestoreModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i>
                    Partial Restore
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Restoring a folder without all of its contents will leave the unselected items unrelated to that folder. They will move to the Notes/Piles tabs as standalone items.</p>
                <p>Are you sure you want to restore partially?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmPartialRestoreBtn" class="btn btn-pill btn-pill-primary">Restore partially</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        const selectAll = document.getElementById('selectAll');
        const restoreBtn = document.getElementById('restoreBtn');
        const deleteBtn = document.getElementById('deleteBtn');
        const itemCheckboxes = document.querySelectorAll('.item-cb');

        function getCheckedItems() {
            return Array.from(document.querySelectorAll('.item-cb:checked'));
        }

        function updateButtons() {
            const count = getCheckedItems().length;
            restoreBtn.disabled = count === 0;
            deleteBtn.disabled = count === 0;
            document.getElementById('deleteCount').textContent = count;
        }

        selectAll.addEventListener('change', function() {
            itemCheckboxes.forEach(cb => {
                if (!cb.disabled) cb.checked = this.checked;
            });
            updateButtons();
        });

        itemCheckboxes.forEach(cb => {
            cb.addEventListener('change', function() {
                const type = this.dataset.type;
                const folderId = this.dataset.folderId;

                if (type === 'folder' && this.checked) {
                    document.querySelectorAll(`.child-cb[data-folder-id="${folderId}"]`).forEach(child => {
                        child.checked = true;
                    });
                } else if (type === 'folder' && !this.checked) {
                    document.querySelectorAll(`.child-cb[data-folder-id="${folderId}"]`).forEach(child => {
                        child.checked = false;
                    });
                } else if (this.classList.contains('child-cb') && this.dataset.type === 'pile' && this.checked) {
                    const folderCb = document.querySelector(`.folder-cb[data-folder-id="${folderId}"]`);
                    if (folderCb) folderCb.checked = true;
                }

                updateButtons();
            });
        });

        function populateAndSubmit(formId) {
            const form = document.getElementById(formId);
            form.querySelectorAll('input[name="folderIds"], input[name="pileIds"], input[name="noteIds"]').forEach(i => i.remove());

            getCheckedItems().forEach(cb => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = cb.dataset.type + 'Ids';
                input.value = cb.dataset.id;
                form.appendChild(input);
            });

            form.submit();
        }

        restoreBtn.addEventListener('click', function() {
            const checked = getCheckedItems();
            const checkedFolderIds = new Set(checked.filter(c => c.dataset.type === 'folder').map(c => c.dataset.id));

            let hasPartialRestore = false;
            for (const fid of checkedFolderIds) {
                const children = document.querySelectorAll(`.child-cb[data-folder-id="${fid}"]`);
                const uncheckedChildren = Array.from(children).filter(c => !c.checked);
                if (uncheckedChildren.length > 0) {
                    hasPartialRestore = true;
                    break;
                }
            }

            if (hasPartialRestore) {
                const modal = new bootstrap.Modal(document.getElementById('partialRestoreModal'));
                modal.show();
            } else {
                populateAndSubmit('restoreForm');
            }
        });

        document.getElementById('confirmPartialRestoreBtn').addEventListener('click', function() {
            populateAndSubmit('restoreForm');
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            populateAndSubmit('deleteForm');
        });
    })();
</script>
