@using NoteVault.ViewModels
@model List<NoteVault.ViewModels.SearchResultRowDto>

@{
    var searchUrl = ViewData["SearchUrl"] as string ?? "/Search/Results";
}

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p>No results found.</p>
        <p class="small">Try different keywords or adjusting the filters.</p>
    </div>
}
else
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var r in Model)
            {
                var cleanTitle = System.Text.RegularExpressions.Regex.Replace(r.Title, "</?b>", "");
                var cleanSnippet = System.Text.RegularExpressions.Regex.Replace(r.Snippet ?? "", "</?b>", "");

                <a href="@Url.Action("Details", "Notes", new { id = r.Id, from = "search", returnUrl = searchUrl})"
                   class="list-group-item list-group-item-action py-3 text-decoration-none">
                    <div class="d-flex align-items-center mb-1">
                        <span class="me-2" style="font-size: 1.1rem;">📝</span>
                        <strong class="text-dark me-2">@cleanTitle</strong>
                        @if (r.Tags.Any())
                        {
                            <span style="display: inline-flex; flex-wrap: wrap; gap: 4px;">
                                @foreach (var t in r.Tags.Take(3))
                                {
                                    <span class="note-tag-badge" style="border-color: @(t.Color ?? "#868E96"); background-color: @((t.Color ?? "#868E96") + "33");">@t.Name</span>
                                }
                                @if (r.Tags.Count > 3)
                                {
                                    <span class="note-tag-badge note-tag-more">+@(r.Tags.Count - 3) more</span>
                                }
                            </span>
                        }
                        <span class="text-muted ms-auto small">
                            <partial name="_LocalDate" model="r.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(cleanSnippet))
                    {
                        <div class="text-muted small ps-4">@cleanSnippet</div>
                    }
                    @if (!string.IsNullOrEmpty(r.FolderName))
                    {
                        <div class="text-muted small ps-4 mt-1">📁 @r.FolderName</div>
                    }
                </a>
            }
        </div>
    </div>
}
