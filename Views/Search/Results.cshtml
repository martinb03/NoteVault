@using NoteVault.ViewModels
@model NoteVault.ViewModels.SearchResultsViewModel

@{
ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Search" : $"Results for «{Model.Query}»";
Layout = "_Layout";
}

<style>
    .search-results-page {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .search-results-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .search-results-header .accent-bar {
        width: 4px;
        height: 36px;
        background: var(--brand-orange);
        border-radius: var(--radius-pill);
    }
    .search-results-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
    }
    .search-results-header .query {
        color: var(--brand-orange);
    }

    /* Sidebar */
    .search-sidebar {
        position: sticky;
        top: 80px;
    }
    .search-sidebar .filter-section {
        margin-bottom: 1.5rem;
    }
    .search-sidebar .filter-section:last-child {
        margin-bottom: 0;
    }
    .search-sidebar .filter-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .search-sidebar .filter-label i {
        color: var(--brand-orange);
        font-size: 0.9rem;
    }

    .search-sidebar .form-select,
    .search-sidebar input[type="date"] {
        border: 1.5px solid var(--border-warm);
        border-radius: 8px;
        padding: 0.4rem 0.7rem;
        font-size: 0.85rem;
        color: var(--text-primary);
        background-color: var(--surface);
        width: 100%;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-sidebar .form-select:focus,
    .search-sidebar input[type="date"]:focus {
        border-color: var(--brand-orange);
        box-shadow: 0 0 0 3px rgba(var(--brand-orange-rgb), 0.15);
        outline: none;
    }

    .search-sidebar .show-all-btn {
        background: none;
        border: 0;
        padding: 0;
        font-size: 0.8rem;
        color: var(--brand-orange);
        cursor: pointer;
        margin-top: 0.5rem;
        text-decoration: none;
    }
    .search-sidebar .show-all-btn:hover {
        text-decoration: underline;
    }

    /* Sort + count strip */
    .results-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        padding: 0 0.25rem;
    }
    .results-strip .count {
        color: var(--text-secondary);
        font-size: 0.85rem;
    }
    .results-strip .sort-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .results-strip .sort-label {
        color: var(--text-secondary);
        font-size: 0.85rem;
    }
    .results-strip .sort-select {
        border: 1.5px solid var(--border-warm);
        border-radius: 8px;
        padding: 0.3rem 0.6rem;
        font-size: 0.85rem;
        color: var(--text-primary);
        background-color: var(--surface);
        width: auto;
        transition: border-color 0.15s;
    }
    .results-strip .sort-select:focus {
        border-color: var(--brand-orange);
        outline: none;
    }

    /* Result row content (extends trash-row layout) */
    .result-row {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--border-soft);
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s;
    }
    .result-row:last-child {
        border-bottom: none;
    }
    .result-row:hover {
        background-color: var(--hover-warm);
        color: inherit;
    }
    .result-row-top {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .result-row-top .row-icon {
        color: var(--brand-orange);
        opacity: 0.7;
        font-size: 1rem;
    }
    .result-row-top .row-title {
        font-weight: 600;
        color: var(--text-primary);
        flex-grow: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .result-row-top .row-date {
        font-size: 0.75rem;
        color: var(--text-secondary);
        white-space: nowrap;
    }
    .result-snippet {
        font-size: 0.85rem;
        color: var(--text-secondary);
        padding-left: 1.6rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .result-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding-left: 1.6rem;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }
    .result-meta .folder-ref {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }
    .result-meta .tags-inline {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
    }
    .result-meta .note-tag-badge {
        margin-left: 0;
    }
</style>

<div class="search-results-page">

    <div class="search-results-header">
        <div class="accent-bar"></div>
        <h1>
            @if (string.IsNullOrWhiteSpace(Model.Query))
            {
            <span>Filtered notes</span>
            }
            else
            {
            <span>Results for </span><span class="query">«@Model.Query»</span>
            }
        </h1>
    </div>

    @if (string.IsNullOrWhiteSpace(Model.Query) && !Model.TagIds.Any() && Model.FolderId == null)
    {
    <div class="empty-state">
        <i class="bi bi-search"></i>
        <p>Type a query in the search bar above to find notes.</p>
    </div>
    }
    else
    {
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="soft-card search-sidebar">

                <!-- Tags -->
                <div class="filter-section">
                    <div class="filter-label">
                        <i class="bi bi-tags"></i> Tags
                    </div>
                    <div class="d-flex flex-wrap gap-2" id="tagFilterContainer">
                        @{
                            var sortedTags = Model.AvailableTags
                                .OrderByDescending(t => Model.TagIds.Contains(t.Id))
                                .ThenBy(t => t.Name)
                                .ToList();
                            var visibleTags = sortedTags.Take(4).ToList();
                            var hiddenTags = sortedTags.Skip(4).ToList();
                        }
                        @foreach (var t in visibleTags)
                        {
                        var selected = Model.TagIds.Contains(t.Id) ? "selected" : "";
                        <div class="filter-tag-chip @selected" data-tag-id="@t.Id"
                             style="border-color: @(t.Color ?? "#868E96"); background-color: @((t.Color ?? "#868E96") + "33");">
                            @t.Name
                        </div>
                        }
                        <div id="hiddenTagsGroup" style="display: none; gap: 8px; flex-wrap: wrap;">
                            @foreach (var t in hiddenTags)
                            {
                            var selected = Model.TagIds.Contains(t.Id) ? "selected" : "";
                            <div class="filter-tag-chip @selected" data-tag-id="@t.Id"
                                 style="border-color: @(t.Color ?? "#868E96"); background-color: @((t.Color ?? "#868E96") + "33");">
                                @t.Name
                            </div>
                            }
                        </div>
                    </div>
                    @if (hiddenTags.Any())
                    {
                    <button type="button" id="showMoreTagsBtn" class="show-all-btn">Show all (@Model.AvailableTags.Count)</button>
                    }
                </div>

                <!-- Folder -->
                <div class="filter-section">
                    <div class="filter-label">
                        <i class="bi bi-folder"></i> Folder
                    </div>
                    <select id="folderFilter" class="form-select">
                        <option value="">Any folder</option>
                        @foreach (var f in Model.AvailableFolders)
                        {
                        <option value="@f.Id" selected="@(f.Id == Model.FolderId)">@f.Name</option>
                        }
                    </select>
                </div>

                <!-- Date -->
                <div class="filter-section">
                    <div class="filter-label">
                        <i class="bi bi-calendar"></i> Date
                    </div>
                    <select id="dateTypeFilter" class="form-select mb-2">
                        <option value="updated" selected="@(Model.DateType == "updated")">Last updated</option>
                        <option value="created" selected="@(Model.DateType == "created")">Created</option>
                    </select>
                    <input type="date" id="dateFromFilter" class="mb-2"
                           value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" placeholder="From"/>
                    <input type="date" id="dateToFilter"
                           value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" placeholder="To"/>
                </div>
            </div>
        </div>

        <!-- Results -->
        <div class="col-md-9">
            <div class="results-strip">
                <span class="count" id="resultsCount">@Model.Results.Count @(Model.Results.Count == 1 ? "result" : "results")</span>
                <div class="sort-wrap">
                    <label for="sortFilter" class="sort-label">Sort:</label>
                    <select id="sortFilter" class="sort-select">
                        <option value="relevance" selected="@(Model.Sort == "relevance")">Relevance</option>
                        <option value="updated" selected="@(Model.Sort == "updated")">Last updated</option>
                    </select>
                </div>
            </div>

            <div id="resultsContainer">
                <partial name="_ResultsList" model="Model.Results"/>
            </div>
        </div>
    </div>
    }
</div>

<script>
    (function() {
        const initialQuery = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Query));

        let activeFilters = {
            q: initialQuery,
            tagIds: new Set([@string.Join(",", Model.TagIds)]),
            folderId: @(Model.FolderId?.ToString() ?? "null"),
            dateFrom: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DateFrom?.ToString("yyyy-MM-dd") ?? "")),
            dateTo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DateTo?.ToString("yyyy-MM-dd") ?? "")),
            dateType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DateType)),
            sort: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sort))
        };

        let debounceTimer = null;

        function buildParams() {
            const params = new URLSearchParams();
            if (activeFilters.q) params.set('q', activeFilters.q);
            activeFilters.tagIds.forEach(id => params.append('tagIds', id));
            if (activeFilters.folderId !== null && activeFilters.folderId !== '') params.set('folderId', activeFilters.folderId);
            if (activeFilters.dateFrom) params.set('dateFrom', activeFilters.dateFrom);
            if (activeFilters.dateTo) params.set('dateTo', activeFilters.dateTo);
            if (activeFilters.dateType !== 'updated') params.set('dateType', activeFilters.dateType);
            if (activeFilters.sort !== 'relevance') params.set('sort', activeFilters.sort);
            return params;
        }

        async function refreshResults() {
            const params = buildParams();
            const newUrl = `/Search/Results?${params.toString()}`;
            window.history.replaceState(null, '', newUrl);

            const container = document.getElementById('resultsContainer');
            try {
                const res = await fetch(`/Search/ResultsPartial?${params.toString()}`);
                if (!res.ok) return;
                const html = await res.text();
                container.innerHTML = html;

                const items = container.querySelectorAll('.result-row').length;
                document.getElementById('resultsCount').textContent = items + (items === 1 ? ' result' : ' results');
            } catch (e) {
                console.error('Failed to refresh results', e);
            }
        }

        function debouncedRefresh() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(refreshResults, 300);
        }

        document.querySelectorAll('.filter-tag-chip').forEach(chip => {
            chip.addEventListener('click', function() {
                const id = parseInt(this.dataset.tagId);
                if (activeFilters.tagIds.has(id)) {
                    activeFilters.tagIds.delete(id);
                    this.classList.remove('selected');
                } else {
                    activeFilters.tagIds.add(id);
                    this.classList.add('selected');
                }
                reorderTagChips();
                refreshResults();
            });
        });

        function reorderTagChips() {
            const container = document.getElementById('tagFilterContainer');
            const hiddenGroup = document.getElementById('hiddenTagsGroup');

            // Gather all chips (from both visible and hidden groups)
            const allChips = [
                ...container.querySelectorAll(':scope > .filter-tag-chip'),
                ...(hiddenGroup ? hiddenGroup.querySelectorAll('.filter-tag-chip') : [])
            ];

            // Sort: selected first, then by original DOM order (preserves alphabetical fallback)
            allChips.sort((a, b) => {
                const aSel = a.classList.contains('selected') ? 0 : 1;
                const bSel = b.classList.contains('selected') ? 0 : 1;
                return aSel - bSel;
            });

            // Take first 4 to visible, rest to hidden
            allChips.forEach((chip, idx) => {
                if (idx < 4) {
                    container.insertBefore(chip, hiddenGroup);
                } else if (hiddenGroup) {
                    hiddenGroup.appendChild(chip);
                }
            });
        }

        const showMoreBtn = document.getElementById('showMoreTagsBtn');
        if (showMoreBtn) {
            showMoreBtn.addEventListener('click', function() {
                const group = document.getElementById('hiddenTagsGroup');
                const visible = group.style.display !== 'none';
                group.style.display = visible ? 'none' : 'inline-flex';
                this.textContent = visible ? 'Show all (' + (@Model.AvailableTags.Count) + ')' : 'Show less';
            });
        }

        document.getElementById('folderFilter').addEventListener('change', function() {
            activeFilters.folderId = this.value || null;
            refreshResults();
        });
        document.getElementById('dateTypeFilter').addEventListener('change', function() {
            activeFilters.dateType = this.value;
            refreshResults();
        });
        document.getElementById('dateFromFilter').addEventListener('change', function() {
            activeFilters.dateFrom = this.value;
            debouncedRefresh();
        });
        document.getElementById('dateToFilter').addEventListener('change', function() {
            activeFilters.dateTo = this.value;
            debouncedRefresh();
        });
        document.getElementById('sortFilter').addEventListener('change', function() {
            activeFilters.sort = this.value;
            refreshResults();
        });
    })();
</script>
