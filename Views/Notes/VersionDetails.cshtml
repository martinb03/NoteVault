@using NoteVault.ViewModels
@model NoteVault.ViewModels.VersionDetailsViewModel

@{
    ViewData["Title"] = Model.Name ?? $"Version {Model.VersionNumber}";
    Layout = "_Layout";

    var fromShares = Context.Request.Query["from"] == "shares";
    var fromNotes = Context.Request.Query["from"] == "notes";
    var fromParam = Context.Request.Query["from"].ToString();
    var crumbs = new List<BreadcrumbItem>();

    if (fromShares)
    {
        crumbs.Add(new("Shared", Url.Action("SharedWithMe", "Shares")));
        if (Model.FolderId != null && !string.IsNullOrEmpty(Model.FolderName))
        {
            crumbs.Add(new(Model.FolderName!, Url.Action("Details", "Folders", new { id = Model.FolderId, from = "shares" })));
        }
    }
    else if (!fromNotes && Model.FolderId != null)
    {
        crumbs.Add(new("Folders", Url.Action("Index", "Folders")));
        crumbs.Add(new(Model.FolderName!, Url.Action("Details", "Folders", new { id = Model.FolderId })));
    }
    else
    {
        crumbs.Add(new("Notes", Url.Action("Index", "Notes")));
    }
    crumbs.Add(new(Model.NoteTitle, Url.Action("Details", "Notes", new { id = Model.NoteId, from = fromParam })));
    crumbs.Add(new("Versions", Url.Action("Versions", "Notes", new { id = Model.NoteId, from = fromParam })));
    crumbs.Add(new(Model.Name ?? $"Version {Model.VersionNumber}"));
    ViewData["Breadcrumb"] = crumbs;
}

<partial name="_Breadcrumb"/>

<div class="version-details">
    <div class="version-cols">

        <!-- ═══════ Left Sidebar: Hero + Info ═══════ -->
        <aside class="version-left">
            <div class="version-hero">
                <i class="bi bi-clock-history version-hero-icon"></i>
                <div class="version-hero-text">
                    @if (!string.IsNullOrEmpty(Model.Name))
                    {
                        <h1 class="version-hero-title">@Model.Name</h1>
                        <div class="version-hero-subtitle">Version @Model.VersionNumber</div>
                    }
                    else
                    {
                        <h1 class="version-hero-title">Version @Model.VersionNumber</h1>
                    }
                </div>
            </div>

            <div class="version-info-section">
                <div class="version-info-label">Source</div>
                <div class="meta-row">
                    <i class="bi bi-journal-text"></i>
                    <a asp-controller="Notes" asp-action="Details" asp-route-id="@Model.NoteId" asp-route-from="@fromParam"
                       class="version-source-link">@Model.NoteTitle</a>
                </div>
            </div>

            <div class="version-info-section">
                <div class="version-info-label">Info</div>
                <div class="meta-row">
                    <i class="bi bi-clock"></i>
                    <div>
                        <div class="meta-row-label">Saved</div>
                        <partial name="_LocalDate" model="Model.CreatedAt"/>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ═══════ Center: Content ═══════ -->
        <main class="version-center">
            @if (TempData["Success"] != null)
            {
                <div class="nv-alert alert alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill alert-icon"></i>
                    <span>@TempData["Success"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="soft-card version-content-card">
                @if (string.IsNullOrWhiteSpace(Model.Content))
                {
                    <div class="empty-state">
                        <i class="bi bi-file-earmark"></i>
                        <p>This version has no content.</p>
                    </div>
                }
                else
                {
                    <div class="version-content">
                        @Html.Raw(Model.Content)
                    </div>
                }
            </div>
        </main>

        <!-- ═══════ Right Sidebar: Actions ═══════ -->
        <aside class="version-right">
            <div class="action-list">
                @if (Model.IsOwner)
                {
                    <button class="action-item" data-bs-toggle="modal" data-bs-target="#editTitleModal">
                        <i class="bi bi-pencil"></i> Edit Title
                    </button>
                }
                @if (Model.IsOwner)
                {
                    <button class="action-item" data-bs-toggle="modal" data-bs-target="#restoreVersionModal">
                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                    </button>
                }
                <a href="#" class="action-item">
                    <i class="bi bi-download"></i> Export
                </a>
                @if (Model.IsOwner)
                {
                    <button class="action-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteVersionModal">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                }
            </div>
        </aside>
    </div>
</div>

<!-- Edit Title Modal -->
<div class="modal fade nv-modal" id="editTitleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-pencil"></i> Edit Version Title
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateVersionName" method="post" class="nv-form">
                <input type="hidden" name="id" value="@Model.Id"/>
                <div class="modal-body">
                    <label class="form-label">Title <span class="text-muted" style="font-weight: normal; text-transform: none; letter-spacing: 0;">(optional)</span></label>
                    <input type="text" name="name" class="form-control" value="@Model.Name" placeholder="e.g. Before refactor"/>
                    <p class="text-muted small mt-2 mb-0">Leave blank to remove the title.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pill btn-pill-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Restore Version Modal -->
<div class="modal fade nv-modal" id="restoreVersionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore Version
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Restore the note to <strong>@(Model.Name ?? $"Version {Model.VersionNumber}")</strong>?</p>
                <p class="text-muted small">The current content of the note will be replaced with this version's content. A new version will be saved before restoring, so your current work won't be lost.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="RestoreVersion" method="post">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <button type="submit" class="btn btn-pill btn-pill-primary">Restore</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Version Modal -->
<div class="modal fade nv-modal" id="deleteVersionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Delete Version
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@(Model.Name ?? $"Version {Model.VersionNumber}")</strong>?</p>
                <p class="text-muted small">This action is permanent and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteVersion" method="post">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <button type="submit" class="btn btn-pill btn-pill-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* ─── Layout ──────────────────────────────────────── */
    .version-details {
        max-width: 1400px;
        margin: 0.5rem auto 2rem auto;
        padding: 0 1.5rem;
    }
    .version-cols {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }
    .version-left { flex: 0 0 16%; position: sticky; top: 80px; }
    .version-center { flex: 1; min-width: 0; }
    .version-right { flex: 0 0 16%; position: sticky; top: 80px; }

    /* ─── Left: Hero + Info ──────────────────────────── */
    .version-hero {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }
    .version-hero-icon {
        font-size: 1.4rem;
        color: var(--brand-orange);
        flex-shrink: 0;
        margin-top: 0.15rem;
    }
    .version-hero-text {
        min-width: 0;
        flex-grow: 1;
    }
    .version-hero-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
        word-wrap: break-word;
        line-height: 1.3;
    }
    .version-hero-subtitle {
        margin-top: 0.2rem;
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .version-info-section { margin-bottom: 1.25rem; }
    .version-info-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        color: var(--text-secondary);
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--border-soft);
        margin-bottom: 0.65rem;
    }
    .meta-row {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-primary);
    }
    .meta-row:last-child { margin-bottom: 0; }
    .meta-row i {
        color: var(--brand-orange);
        opacity: 0.85;
        font-size: 0.9rem;
        margin-top: 0.15rem;
        flex-shrink: 0;
        width: 1rem;
        text-align: center;
    }
    .meta-row-label {
        font-size: 0.7rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .version-source-link {
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.15s;
        word-break: break-word;
    }
    .version-source-link:hover {
        color: var(--brand-orange);
    }

    /* ─── Center: Content card ───────────────────────── */
    .version-content-card {
        min-height: 450px;
        padding: 2rem 2.5rem;
    }
    .version-content {
        color: var(--text-primary);
        line-height: 1.6;
        font-size: 1rem;
    }
    .version-content h1, .version-content h2, .version-content h3 {
        color: var(--text-primary);
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }
    .version-content h1:first-child,
    .version-content h2:first-child,
    .version-content h3:first-child { margin-top: 0; }
    .version-content blockquote {
        border-left: 3px solid var(--brand-orange);
        padding-left: 1rem;
        color: var(--text-secondary);
        margin: 1rem 0;
    }
    .version-content pre {
        background: var(--surface-warm);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        overflow-x: auto;
    }
    .version-content code {
        background: var(--surface-warm);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 0.9em;
    }

    /* ─── Action list (right sidebar) ────────────────── */
    .action-list {
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .action-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 0.5rem;
        background: transparent;
        border: 0;
        color: var(--text-medium);
        font-size: 0.9rem;
        font-weight: 500;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.15s;
        width: 100%;
    }
    .action-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 15%;
        right: 15%;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-soft) 30%, var(--border-soft) 70%, transparent);
        transition: left 0.2s, right 0.2s, background 0.2s, height 0.2s;
    }
    .action-item::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 15%;
        right: 15%;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-soft) 30%, var(--border-soft) 70%, transparent);
        transition: left 0.2s, right 0.2s, background 0.2s, height 0.2s;
    }
    .action-list .action-item:first-child::before { opacity: 0; }
    .action-list .action-item:last-child::after { opacity: 0; }
    .action-item:hover { color: var(--brand-orange); }
    .action-item:hover::before,
    .action-item:hover::after {
        left: 0; right: 0; height: 1.5px;
        background: linear-gradient(to right, transparent, var(--brand-orange) 20%, var(--brand-orange) 80%, transparent);
    }
    .action-item:hover + .action-item::before {
        left: 0; right: 0; height: 1.5px;
        background: linear-gradient(to right, transparent, var(--brand-orange) 20%, var(--brand-orange) 80%, transparent);
    }
    .action-item i {
        font-size: 1rem;
        color: var(--brand-orange);
        opacity: 0.85;
        width: 1.2rem;
        flex-shrink: 0;
    }
    .action-item.text-danger { color: var(--danger); }
    .action-item.text-danger i { color: var(--danger); }

    @@media (max-width: 992px) {
        .version-cols { flex-direction: column; }
        .version-left, .version-right { flex: 1 1 100%; width: 100%; position: static; }
    }
</style>
