@model NoteVault.ViewModels.NoteListPageViewModel

@{
    ViewData["Title"] = "Notes";
    Layout = "_Layout";
}

<div class="notes-page">

    <div class="notes-header">
        <div class="notes-header-title">
            <div class="accent-bar"></div>
            <h1>Notes</h1>
            <!-- All / Unfiled segmented control -->
            <div class="segmented-control">
                <a asp-action="Index" asp-route-unfiledOnly="false"
                   class="segment @(!Model.ShowUnfiledOnly ? "active" : "")">All</a>
                <a asp-action="Index" asp-route-unfiledOnly="true"
                   class="segment @(Model.ShowUnfiledOnly ? "active" : "")">Unfiled</a>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="inline-filter-wrap">
                <i class="bi bi-search inline-filter-icon"></i>
                <input type="text" id="noteFilter" class="inline-filter-input" placeholder="Filter notes..." autocomplete="off"/>
            </div>
            <button class="btn btn-pill btn-pill-primary" data-bs-toggle="modal" data-bs-target="#createNoteModal">
                <i class="bi bi-plus-lg"></i> New Note
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="nv-alert alert alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill alert-icon"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="nv-alert alert alert-dismissible fade show" role="alert" style="border-color: var(--danger);">
            <i class="bi bi-exclamation-circle-fill alert-icon" style="color: var(--danger);"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Notes.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <p>@(Model.ShowUnfiledOnly ? "No unfiled notes." : "No notes yet.")</p>
            @if (!Model.ShowUnfiledOnly)
            {
                <button class="btn btn-pill btn-pill-outline mt-2" data-bs-toggle="modal" data-bs-target="#createNoteModal">
                    Create your first note
                </button>
            }
        </div>
    }
    else
    {
        <div class="trash-list" id="notesList">
            @foreach (var note in Model.Notes)
            {
                var snippet = System.Text.RegularExpressions.Regex.Replace(note.Content ?? "", "<.*?>", " ").Trim();

                <a asp-action="Details" asp-route-id="@note.Id" asp-route-from="notes"
                   class="trash-row text-decoration-none note-row">
                    <i class="bi bi-journal-text row-icon"></i>
                    <span class="row-title">@note.Title</span>
                    <span class="tags-cell">
                        @await Html.PartialAsync("_NoteTagsInline", note.Tags)
                    </span>
                    @if (!string.IsNullOrWhiteSpace(snippet))
                    {
                        <span class="note-snippet">@snippet</span>
                    }
                    <span class="row-meta ms-auto">
                        <partial name="_LocalDate" model="note.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                    </span>
                </a>
            }
        </div>

        <div class="empty-state" id="noNoteMatches" style="display: none;">
            <i class="bi bi-search"></i>
            <p>No notes match your search.</p>
        </div>
    }
</div>

<!-- Create Note Modal -->
<div class="modal fade nv-modal" id="createNoteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-journal-plus"></i> New Note
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post" class="nv-form">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="Title" class="form-control" required autofocus/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Folder</label>
                        <select name="FolderId" class="form-select">
                            <option value="">Unfiled</option>
                            @foreach (var folder in Model.AvailableFolders)
                            {
                                <option value="@folder.Id">@folder.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pill btn-pill-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .notes-page {
        max-width: 1300px;
        margin: 1rem auto;
        padding: 0 1.5rem;
    }

    /* Note rows - title kept compact so tags sit beside it; snippet fills remaining space */
    .notes-page .trash-row .row-title {
        flex-grow: 0;
        flex-shrink: 0;
        width: 200px;
        margin-right: 0.5rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .notes-page .tags-cell {
        flex-shrink: 0;
        width: 280px;
        overflow: hidden;
        display: flex;
        align-items: center;
    }
    .note-snippet {
        flex-grow: 1;
        min-width: 0;
        color: var(--text-secondary);
        font-size: 0.85rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0 1rem;
    }
</style>

<script>
    (function() {
        const filterInput = document.getElementById('noteFilter');
        const notesList = document.getElementById('notesList');
        const noMatchesEl = document.getElementById('noNoteMatches');
        if (!filterInput || !notesList) return;

        filterInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            const rows = notesList.querySelectorAll('.note-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const title = row.querySelector('.row-title').textContent.trim().toLowerCase();
                const match = title.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            notesList.style.display = visibleCount === 0 ? 'none' : '';
            noMatchesEl.style.display = visibleCount === 0 && rows.length > 0 ? 'block' : 'none';
        });
    })();
</script>
