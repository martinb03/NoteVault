@model NoteVault.ViewModels.NoteListPageViewModel

@{
    ViewData["Title"] = "Notes";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h4 class="mb-0">Notes</h4>
            <div class="btn-group btn-group-sm">
                <a asp-action="Index" asp-route-unfiledOnly="false"
                   class="btn @(!Model.ShowUnfiledOnly ? "btn-primary" : "btn-outline-secondary")">All</a>
                <a asp-action="Index" asp-route-unfiledOnly="true"
                   class="btn @(Model.ShowUnfiledOnly ? "btn-primary" : "btn-outline-secondary")">Unfiled</a>
            </div>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createNoteModal">New Note</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Notes.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <p class="mb-2">@(Model.ShowUnfiledOnly ? "No unfiled notes." : "No notes yet.")</p>
        </div>
    }
    else
    {
        @*<table class="text-muted"  style="font-size: 15px; border: black">
            <tr>
                <th style="width: 55px"></th>
                <th style="width: 200px; text-align: left">Title</th>
                <th style="width: 900px; text-align: left">Description</th>
                <th>Last Updated</th>
            </tr>
        </table>*@
        <div class="d-flex align-items-center py-2 px-3 text-muted small fw-bold text-uppercase" style="border: 1px solid #dee2e6;">
            <span class="me-3" style="font-size: 1.1rem; width: 23px;"></span>
            <span style="width: 200px;">Title</span>
            <span style="flex: 1; padding-right: 85px;">Content</span>
            <span class="text-end" style="padding-right: 35px">Updated</span>
        </div>
        <div class="card">
            <div class="list-group list-group-flush">
                @foreach (var note in Model.Notes)
                {
                    <a asp-action="Details" asp-route-id="@note.Id" class="list-group-item list-group-item-action d-flex align-items-center py-3 text-decoration-none">
                        <span class="me-3" style="font-size: 1.1rem;">📝</span>
                        <strong class="text-dark" style="width: 200px;">@note.Title</strong>
                        <span class="text-muted text-truncate" style="flex: 1; padding-right: 85px">
                            @System.Text.RegularExpressions.Regex.Replace(@note.Content ?? "", "<.*?>", " ").Trim()
                        </span>
                        <span class="text-muted text-end">
                            <partial name="_LocalDate" model="note.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date"}} )"/>
                        </span>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Create Note Modal -->
<div class="modal fade" id="createNoteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Note</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="Title" class="form-control" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Folder</label>
                        <select name="FolderId" class="form-select">
                            <option value="">Unfiled</option>
                            @foreach (var folder in Model.AvailableFolders)
                            {
                                <option value="@folder.Id">@folder.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
