@using NoteVault.ViewModels
@model NoteVault.ViewModels.EditNoteViewModel

@{
ViewData["Title"] = Model.Title;
Layout = "_Layout";

var fromNotes = Context.Request.Query["from"] == "notes";
var crumbs = new List<BreadcrumbItem>();

if (!fromNotes && Model.FolderId != null)
{
crumbs.Add(new("Folders", Url.Action("Index", "Folders")));
crumbs.Add(new(Model.FolderName!, Url.Action("Details", "Folders", new { id = Model.FolderId })));
}
else
{
crumbs.Add(new("Notes", Url.Action("Index", "Notes")));
}
crumbs.Add(new(Model.Title, Url.Action("Details", "Notes", new { id = Model.Id, from = fromNotes ? "notes" : null })));
crumbs.Add(new("Edit"));
ViewData["Breadcrumb"] = crumbs;
var isLocked = Model.LockHeldByUserId != null;
var lockLost = Context.Request.Query["lockLost"] == "1";
}

<!-- Quill CSS -->
<link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet" />

<partial name="_Breadcrumb"/>

<div class="note-edit-page">

    @if (TempData["Success"] != null)
    {
    <div class="nv-alert alert alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill alert-icon"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }
    
    @if (lockLost && isLocked)
    {
        <div class="nv-alert alert alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
            <span>@Model.LockHeldByName took over editing this note. Any changes from the last few seconds may not have been saved.</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Status bar -->
    <div class="edit-status-bar">
        @if (isLocked)
        {
            <div class="save-status">
                <i class="bi bi-lock"></i>
                <span>@Model.LockHeldByName is currently editing</span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-pill btn-pill-outline btn-sm">
                <i class="bi bi-arrow-left"></i> Back to note
            </a>
        }
        else
        {
            <div class="save-status" id="saveStatus">
                <i class="bi bi-cloud-check"></i>
                <span id="saveStatusText">
                    Last saved: <partial name="_LocalDate" model="Model.UpdatedAt"/>
                </span>
            </div>
            <button class="btn btn-pill btn-pill-outline btn-sm" data-bs-toggle="modal" data-bs-target="#saveVersionModal">
                <i class="bi bi-bookmark"></i> Save Version
            </button>
        }
    </div>
 
    <!-- Inline title -->
    <input type="text" id="noteTitle" class="note-title-input" value="@Model.Title"
           placeholder="Untitled note" @(isLocked ? "readonly" : "") />
 
    @if (isLocked)
    {
        <!-- Read-only content with overlay -->
        <div class="editor-wrap editor-locked">
            <div class="editor-locked-content">
                @Html.Raw(Model.Content)
            </div>
            <div class="editor-locked-overlay">
                <i class="bi bi-lock"></i>
                <div class="editor-locked-title">@Model.LockHeldByName is currently editing</div>
                <div class="editor-locked-sub">
                    You're seeing the last saved version. Try again once they're done.
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Quill editor wrapper -->
        <div class="editor-wrap">
            <div id="editor">@Html.Raw(Model.Content)</div>
        </div>
    }
</div>
@if (!isLocked)
{
    <!-- Save Version Modal -->
    <div class="modal fade nv-modal" id="saveVersionModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-bookmark"></i> Save Version
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="SaveVersion" method="post" id="saveVersionForm" class="nv-form">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <div class="modal-body">
                        <label class="form-label">Version Title <span class="text-muted" style="font-weight: normal; text-transform: none; letter-spacing: 0;">(optional)</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Before refactor"/>
                        <p class="text-muted small mt-2 mb-0">Leave blank to save without a title.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-pill btn-pill-outline" id="skipTitleBtn">Skip Title</button>
                        <button type="submit" class="btn btn-pill btn-pill-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<style>
    .note-edit-page {
        max-width: 1100px;
        margin: 0 auto 2rem auto;
        padding: 0 1.5rem;
    }

    /* Status bar */
    .edit-status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }
    .save-status {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
    }
    .save-status i {
        color: var(--brand-orange);
        font-size: 1rem;
    }
    .save-status.saving i { animation: pulse-icon 1.2s ease-in-out infinite; }
    @@keyframes pulse-icon {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 1; }
    }

    /* Title input */
    .note-title-input {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--text-primary);
        border: 1.5px dashed transparent;
        background: transparent;
        width: 100%;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        margin-bottom: 0.75rem;
        transition: border-color 0.15s, background-color 0.15s, box-shadow 0.15s;
    }
    .note-title-input::placeholder {
        color: var(--text-muted);
        font-weight: 500;
    }
    .note-title-input:hover {
        border-color: var(--border-warm);
    }
    .note-title-input:focus {
        border-color: var(--brand-orange);
        border-style: solid;
        outline: none;
        background: var(--surface);
        box-shadow: 0 0 0 3px rgba(var(--brand-orange-rgb), 0.1);
    }

    /* Editor wrapper */
    .editor-wrap {
        background: var(--surface);
        border: 1px solid var(--border-warm);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
    }

    /* Quill overrides to fit theme */
    .ql-toolbar.ql-snow {
        border: 0 !important;
        border-bottom: 1px solid var(--border-soft) !important;
        background-color: var(--surface-warm);
        padding: 0.5rem 0.75rem;
    }
    .ql-container.ql-snow {
        border: 0 !important;
        font-family: inherit;
        font-size: 1rem;
    }
    #editor {
        min-height: 500px;
        padding: 0.5rem 0.5rem 1rem 0.5rem;
    }
    .ql-editor {
        min-height: 500px;
        line-height: 1.6;
        color: var(--text-primary);
    }
    .ql-editor.ql-blank::before {
        color: var(--text-muted);
        font-style: normal;
    }
    .ql-snow .ql-stroke { stroke: var(--text-medium); }
    .ql-snow .ql-fill { fill: var(--text-medium); }
    .ql-snow .ql-picker-label { color: var(--text-medium); }
    .ql-snow .ql-picker-label:hover,
    .ql-snow .ql-picker-label.ql-active,
    .ql-snow button:hover,
    .ql-snow button.ql-active {
        color: var(--brand-orange) !important;
    }
    .ql-snow .ql-picker-label:hover .ql-stroke,
    .ql-snow .ql-picker-label.ql-active .ql-stroke,
    .ql-snow button:hover .ql-stroke,
    .ql-snow button.ql-active .ql-stroke {
        stroke: var(--brand-orange) !important;
    }
    .ql-snow .ql-picker-label:hover .ql-fill,
    .ql-snow .ql-picker-label.ql-active .ql-fill,
    .ql-snow button:hover .ql-fill,
    .ql-snow button.ql-active .ql-fill {
        fill: var(--brand-orange) !important;
    }
    .ql-editor blockquote {
        border-left: 3px solid var(--brand-orange);
        padding-left: 1rem;
        color: var(--text-secondary);
    }
    .ql-editor pre.ql-syntax,
    .ql-editor pre {
        background: var(--surface-warm);
        color: var(--text-primary);
        padding: 0.75rem 1rem;
        border-radius: 8px;
    }
    .ql-editor code {
        background: var(--surface-warm);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
    }
    /* ------- Locked (someone else is editing) ------- */
    .editor-locked { position: relative; }
    .editor-locked-content {
        padding: 1.25rem;
        min-height: 320px;
        filter: blur(2px);
        opacity: 0.45;
        pointer-events: none;
        user-select: none;
    }
    .editor-locked-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        text-align: center;
        padding: 1.5rem;
    }
    .editor-locked-overlay > i {
        font-size: 1.8rem;
        color: var(--brand-orange);
        margin-bottom: 0.2rem;
    }
    .editor-locked-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .editor-locked-sub {
        font-size: 0.85rem;
        color: var(--text-secondary);
        max-width: 320px;
    }
</style>
<!-- Quill JS -->
<script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
@if(!isLocked)
{
<script>
    const quill = new Quill('#editor', {
        theme: 'snow',
        placeholder: 'Start writing...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                ['blockquote', 'code-block'],
                ['link'],
                ['clean']
            ]
        }
    });

    const noteId = @Model.Id;
    const titleInput = document.getElementById('noteTitle');
    const saveStatus = document.getElementById('saveStatus');
    const saveStatusText = document.getElementById('saveStatusText');
    let saveTimeout;
    let isDirty = false;
    let lastSavedAt = Date.now();
    const MAX_SAVE_INTERVAL = 15000;  // force a checkpoint if typing never pauses

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    }

    // ── Acquire lock on page load ──
    (async function acquireLock() {
        const formData = new FormData();
        const t = getToken();
        if (t) formData.append('__RequestVerificationToken', t);

        try {
            const res = await fetch(`/Notes/AcquireLock/${noteId}`, {
                method: 'POST',
                body: formData
            });
            const result = await res.json();
            if (!result.acquired) {
                // Someone claimed it between page render and now — reload
                // so the server can render the locked state.
                window.location.reload();
            }
        } catch (e) {
            console.error('Failed to acquire lock', e);
        }
    })();

    // ── Heartbeat every 60s ──
    setInterval(async () => {
        const formData = new FormData();
        const t = getToken();
        if (t) formData.append('__RequestVerificationToken', t);
        try {
            const res = await fetch(`/Notes/RefreshLock/${noteId}`, { method: 'POST', body: formData });
            const result = await res.json();
            if (!result.success) {
                window.location.href = `/Notes/Edit/${noteId}?lockLost=1`;
            }
        } catch { /* transient network failure — try again next tick */ }
    }, 60000);

    // The actual save. Shared by the debounce, the ceiling, and forceSave.
    async function doSave(useKeepalive = false) {
        clearTimeout(saveTimeout);
        if (!isDirty) return;
        isDirty = false;

        saveStatus.classList.add('saving');
        saveStatusText.textContent = 'Saving...';

        try {
            const response = await fetch('/Notes/AutoSave', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: noteId,
                    title: titleInput.value || 'Untitled note',
                    content: quill.root.innerHTML
                }),
                keepalive: useKeepalive
            });

            const result = await response.json();
            if (!result.success) {
                if (result.reason === 'lock_lost') {
                    window.location.href = `/Notes/Edit/${noteId}?lockLost=1`;
                    return;
                }
                throw new Error();
            }

            lastSavedAt = Date.now();

            const date = new Date(result.updatedAt);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            saveStatusText.textContent = `Saved at ${hours}:${minutes}, ${day}/${month}/${year}`;
        } catch {
            // Failed save means the content wasn't persisted — keep it dirty
            // so the next attempt retries instead of dropping the changes.
            isDirty = true;
            saveStatusText.textContent = 'Save failed';
        } finally {
            saveStatus.classList.remove('saving');
        }
    }

    // Debounced trigger with a hard ceiling: continuous typing still
    // checkpoints every MAX_SAVE_INTERVAL even without a pause.
    function triggerAutoSave() {
        clearTimeout(saveTimeout);
        if (Date.now() - lastSavedAt > MAX_SAVE_INTERVAL) {
            doSave();
            return;
        }
        saveTimeout = setTimeout(doSave, 5000);
    }

    quill.on('text-change', () => { isDirty = true; triggerAutoSave(); });
    titleInput.addEventListener('input', () => { isDirty = true; triggerAutoSave(); });

    function forceSave() {
        return doSave(true);
    }

    titleInput.addEventListener('blur', forceSave);
    quill.root.addEventListener('blur', forceSave);

    // ── Save + release lock on navigation away ──
    window.addEventListener('beforeunload', async () => {
        if (isDirty) await forceSave();
        const token = getToken();
        const data = new FormData();
        if (token) data.append('__RequestVerificationToken', token);
        fetch(`/Notes/ReleaseLock/${noteId}`, {
            method: 'POST',
            body: data,
            keepalive: true
        });
    });

    // ── Skip Title button in Save Version modal ──
    document.getElementById('skipTitleBtn').addEventListener('click', () => {
        document.querySelector('#saveVersionForm input[name="name"]').value = '';
    });
</script>
}