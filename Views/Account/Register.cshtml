@model NoteVault.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}
<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow" style="width: 400px;">
        <div class="card-body p-4">
            <p class="text-center mb-4" style="font-weight: bold; font-size: 28px;">Register</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" placeholder="Your name" autofocus />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" placeholder="At least 8 characters" id="passwordInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('passwordInput', this)">Show</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="d-flex align-items-center justify-content-center">
                    <button type="submit" class="btn btn-primary w-50">Register</button>
                </div>
                <div class="text-center mt-3">
                    <small class="text-muted">
                        Already have an account? <a asp-action="Login" class="text-decoration-none">Log in</a>
                    </small>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    function togglePassword(inputId, button) {
        var input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            button.textContent = "Hide";
        } else {
            input.type = "password";
            button.textContent = "Show";
        }
    }
</script>
