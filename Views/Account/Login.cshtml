@model NoteVault.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
    Layout = "_AuthLayout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="auth-card nv-form">
        <h1 class="auth-title">Log in</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" class="form-control" placeholder="Your password" id="passwordInput"/>
                    <button type="button" class="auth-show-btn" onclick="togglePassword('passwordInput', this)">Show</button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input"/>
                <label asp-for="RememberMe" class="form-check-label" style="text-transform: none; font-weight: normal;"></label>
            </div>

            <button type="submit" class="btn btn-pill btn-pill-primary w-100">Log in</button>

            @if ((bool)(ViewData["IsRegistrationOpen"] ?? false))
            {
                <div class="text-center mt-3">
                    <small class="text-muted">
                        Don't have an account? <a asp-action="Register" class="auth-link">Create one</a>
                    </small>
                </div>
            }
        </form>
    </div>
</div>

<script>
    function togglePassword(inputId, button) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            button.textContent = "Hide";
        } else {
            input.type = "password";
            button.textContent = "Show";
        }
    }
</script>
