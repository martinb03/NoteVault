@model NoteVault.ViewModels.AccountSettingsViewModel

@{
    ViewData["Title"] = "Settings";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">

        @if (User.IsInRole("Admin"))
        {
            <!-- Sidebar (admin only) -->
            <div class="col-md-3">
                <div class="list-group">
                    <a href="#account" class="list-group-item list-group-item-action active" data-bs-toggle="list">Account</a>
                    <a href="#users" class="list-group-item list-group-item-action" data-bs-toggle="list">User Management</a>
                    <a href="#app-settings" class="list-group-item list-group-item-action" data-bs-toggle="list">App Settings</a>
                </div>
            </div>
        }

        <!-- Main content -->
        <div class="@(User.IsInRole("Admin") ? "col-md-9" : "col-md-8 mx-auto")">

            <!-- Success/Error messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="tab-content">

                <!-- ── Account Section ─────────────────────── -->
                <div class="tab-pane fade show active" id="account">
                    <h4 class="mb-4">Account Settings</h4>

                    <!-- Display Name -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Display Name</h6>
                            <form asp-controller="Settings" asp-action="UpdateDisplayName" method="post">
                                <div class="d-flex gap-2">
                                    <input type="text" name="displayName" class="form-control" value="@Model.DisplayName" />
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Email</h6>
                            <form asp-controller="Settings" asp-action="UpdateEmail" method="post">
                                <div class="d-flex gap-2">
                                    <input type="email" name="email" class="form-control" value="@Model.Email" />
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Change Password -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Change Password</h6>
                            <form asp-controller="Settings" asp-action="ChangePassword" method="post">
                                <div class="mb-3">
                                    <label class="form-label">Current Password</label>
                                    <input type="password" name="CurrentPassword" class="form-control" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">New Password</label>
                                    <input type="password" name="NewPassword" class="form-control" required minlength="8" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirm New Password</label>
                                    <input type="password" name="ConfirmNewPassword" class="form-control" required />
                                </div>
                                <button type="submit" class="btn btn-primary">Change Password</button>
                            </form>
                        </div>
                    </div>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <!-- ── User Management Section ─────────────── -->
                    <div class="tab-pane fade" id="users">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0">User Management</h4>
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">Create User</button>
                        </div>

                        <!-- Users table -->
                        <div class="card">
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Role</th>
                                            <th>Created</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="usersTableBody">
                                        <!-- Loaded via JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ── App Settings Section ────────────────── -->
                    <div class="tab-pane fade" id="app-settings">
                        <h4 class="mb-4">App Settings</h4>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="openRegistration">
                                    <label class="form-check-label" for="openRegistration">Allow open registration</label>
                                </div>
                                <small class="text-muted">When enabled, anyone with access to this app can create an account.</small>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Trash Auto-Purge</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="number" class="form-control" style="width: 100px;" value="30" min="1" max="365" />
                                    <span>days</span>
                                    <button class="btn btn-primary ms-2">Save</button>
                                </div>
                                <small class="text-muted">Items in trash will be permanently deleted after this many days.</small>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <!-- Create User Modal -->
    <div class="modal fade" id="createUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Settings" asp-action="CreateUser" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Display Name</label>
                            <input type="text" name="DisplayName" class="form-control" required/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control" required/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="Password" class="form-control" required minlength="8"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select name="Role" class="form-select">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reset Password Modal -->
    <div class="modal fade" id="resetPasswordModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Settings" asp-action="ResetUserPassword" method="post">
                    <div class="modal-body">
                        <input type="hidden" name="userId" id="resetPasswordUserId"/>
                        <p>Resetting password for <strong id="resetPasswordUserName"></strong></p>
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="newPassword" class="form-control" required minlength="8"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Reset Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete User Modal -->
    <div class="modal fade" id="deleteUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Settings" asp-action="DeleteUser" method="post">
                    <div class="modal-body">
                        <input type="hidden" name="userId" id="deleteUserUserId"/>
                        <p>Are you sure you want to delete <strong id="deleteUserName"></strong>?</p>
                        <p class="text-danger">This will permanently remove the account and all their data. This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Load users table when User Management tab is shown
        document.querySelector('a[href="#users"]')?.addEventListener('shown.bs.tab', loadUsers);

        async function loadUsers() {
            const response = await fetch('/Settings/Users');
            const users = await response.json();
            const tbody = document.getElementById('usersTableBody');
            tbody.innerHTML = '';

            users.forEach(user => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${user.displayName}</td>
                    <td>${user.email}</td>
                    <td><span class="badge ${user.role === 'Admin' ? 'bg-primary' : 'bg-secondary'}">${user.role}</span></td>
                    <td>${new Date(user.createdAt).toLocaleDateString('en-GB')}</td>
                    <td><span class="badge ${user.isLockedOut ? 'bg-danger' : 'bg-success'}">${user.isLockedOut ? 'Disabled' : 'Active'}</span></td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" onclick="openResetPassword('${user.id}', '${user.displayName}')">Reset PW</button>
                            <form method="post" action="/Settings/ToggleUserStatus" class="d-inline">
                                <input type="hidden" name="userId" value="${user.id}" />
                                <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name=__RequestVerificationToken]').value}" />
                                <button type="submit" class="btn btn-outline-${user.isLockedOut ? 'success' : 'warning'}">${user.isLockedOut ? 'Enable' : 'Disable'}</button>
                            </form>
                            <button class="btn btn-outline-danger" onclick="openDeleteUser('${user.id}', '${user.displayName}')">Delete</button>
                        </div>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function openResetPassword(userId, displayName) {
            document.getElementById('resetPasswordUserId').value = userId;
            document.getElementById('resetPasswordUserName').textContent = displayName;
            new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
        }

        function openDeleteUser(userId, displayName) {
            document.getElementById('deleteUserUserId').value = userId;
            document.getElementById('deleteUserName').textContent = displayName;
            new bootstrap.Modal(document.getElementById('deleteUserModal')).show();
        }
    </script>
}