@using NoteVault.ViewModels
@model NoteVault.ViewModels.TagDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";

    ViewData["Breadcrumb"] = new List<BreadcrumbItem>
    {
        new("Tags", Url.Action("Index", "Tags")),
        new(Model.Name)
    };

    var color = Model.Color ?? "#868E96";
}

<partial name="_Breadcrumb"/>

<div class="tag-details-page">

    <!-- Hero header -->
    <div class="tag-hero">
        <div class="tag-hero-chip" style="border-color: @color; background-color: @(color)22;">
            @Model.Name
        </div>
        <div class="tag-hero-subtitle">
            @Model.Notes.Count @(Model.Notes.Count == 1 ? "note tagged" : "notes tagged")
        </div>
    </div>

    @if (Model.Notes.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <p>No notes have this tag yet.</p>
        </div>
    }
    else
    {
        <!-- Action bar -->
        <div class="d-flex justify-content-end mb-3">
            <div class="inline-filter-wrap">
                <i class="bi bi-search inline-filter-icon"></i>
                <input type="text" id="noteFilter" class="inline-filter-input" placeholder="Filter notes..." autocomplete="off"/>
            </div>
        </div>

        <!-- Notes list -->
        <div class="trash-list" id="notesList">
            @foreach (var note in Model.Notes)
            {
                <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" asp-route-from="tags"
                   class="trash-row text-decoration-none note-row">
                    <i class="bi bi-journal-text row-icon"></i>
                    <span class="row-title">@note.Title</span>
                    @if (note.Tags.Any())
                    {
                        <span class="d-inline-flex align-items-center gap-1 flex-wrap me-2">
                            @foreach (var t in note.Tags.Where(x => x.Id != Model.Id).Take(3))
                            {
                                <span class="note-tag-badge" style="border-color: @(t.Color ?? "#868E96"); background-color: @((t.Color ?? "#868E96") + "33"); margin-left: 0;">@t.Name</span>
                            }
                            @{
                                var otherTagCount = note.Tags.Count(x => x.Id != Model.Id);
                            }
                            @if (otherTagCount > 3)
                            {
                                <span class="note-tag-badge note-tag-more" style="margin-left: 0;">+@(otherTagCount - 3) more</span>
                            }
                        </span>
                    }
                    <span class="row-meta ms-auto">
                        <partial name="_LocalDate" model="note.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                    </span>
                </a>
            }
        </div>

        <div class="empty-state" id="noNoteMatches" style="display: none;">
            <i class="bi bi-search"></i>
            <p>No notes match your search.</p>
        </div>
    }
</div>

<style>
    .tag-details-page {
        max-width: 1100px;
        margin: 0 auto 2rem auto;
        padding: 0 1.5rem;
    }

    .tag-hero {
        text-align: center;
        padding: 2rem 1rem 2.5rem 1rem;
    }
    .tag-hero-chip {
        display: inline-block;
        border-radius: var(--radius-pill);
        border: 3px solid;
        padding: 0.6rem 2rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        background-color: var(--surface);
    }
    .tag-hero-subtitle {
        margin-top: 0.75rem;
        color: var(--text-secondary);
        font-size: 0.9rem;
    }
</style>

<script>
    (function() {
        const filterInput = document.getElementById('noteFilter');
        const notesList = document.getElementById('notesList');
        const noMatchesEl = document.getElementById('noNoteMatches');
        if (!filterInput || !notesList) return;

        filterInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            const rows = notesList.querySelectorAll('.note-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const title = row.querySelector('.row-title').textContent.trim().toLowerCase();
                const match = title.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            notesList.style.display = visibleCount === 0 ? 'none' : '';
            noMatchesEl.style.display = visibleCount === 0 && rows.length > 0 ? 'block' : 'none';
        });
    })();
</script>
