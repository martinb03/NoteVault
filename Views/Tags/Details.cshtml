@using NoteVault.ViewModels
@model NoteVault.ViewModels.TagDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";

    ViewData["Breadcrumb"] = new List<BreadcrumbItem>
    {
        new("Tags", Url.Action("Index", "Tags")),
        new(Model.Name)
    };
}
<div class="container-fluid mt-4 px-5">
    <partial name="_Breadcrumb"/>
</div>
<div class="container mt-4">
    

    <!-- Tag header -->
    <div class="text-center mb-4">
        <span class="d-inline-block px-4 py-2" style="border: 5px solid @(Model.Color ?? "#868E96"); background-color: @((Model.Color ?? "#868E96") + "33");
             color: #333; border-radius: 8px; font-size: 1.5rem; font-weight: 600;">
            @Model.Name
        </span>
        @*<span class="d-inline-block px-4 py-2"
              style="background-color: @(Model.Color ?? "#868E96"); color: white; border-radius: 8px; font-size: 1.5rem; font-weight: 600;">
            @Model.Name
        </span>*@
        <div class="text-muted mt-2" style="font-size: 0.9rem;">notes</div>
    </div>

    @if (Model.Notes.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <p>No notes have this tag yet.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="list-group list-group-flush">
                @foreach (var note in Model.Notes)
                {
                    <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" asp-route-from="tags"
                       class="list-group-item list-group-item-action d-flex align-items-center py-3 text-decoration-none">
                        <span class="me-3" style="font-size: 1.1rem;">📝</span>
                        <strong class="text-dark">@note.Title</strong>
                        @foreach (var t in note.Tags.Take(3))
                        {
                            <span class="note-tag-badge" style="border-color: @(t.Color ?? "#868E96"); background-color: @((t.Color ?? "#868E96") + "33");">@t.Name</span>
                        }
                        @if (note.Tags.Count > 3)
                        {
                            <span class="note-tag-badge note-tag-more">+@(note.Tags.Count - 3) more</span>
                        }
                        <span class="text-muted ms-auto">
                            <partial name="_LocalDate" model="note.UpdatedAt" view-data="@(new ViewDataDictionary(ViewData) { { "Format", "date" } })"/>
                        </span>
                    </a>
                }
            </div>
        </div>
    }
</div>