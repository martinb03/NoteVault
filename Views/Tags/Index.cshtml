@using NoteVault.ViewModels
@model List<NoteVault.ViewModels.TagListViewModel>

@{
    ViewData["Title"] = "Tags";
    Layout = "_Layout";

    var swatchColors = new[]
    {
        "#FF6B6B", "#FFA94D", "#FFD93D", "#6BCB77", "#4D96FF", "#9B72CF", "#FF6BB5", "#868E96",
        "#20C997", "#F783AC", "#845EF7", "#339AF0", "#FAB005", "#74C0FC", "#8CE99A", "#FFA8A8"
    };
}

<style>
    .tags-page {
        max-width: 1200px;
        margin: 1rem auto;
        padding: 0 1.5rem;
    }
    .tags-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }
    .tags-header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .tags-header .accent-bar {
        width: 4px;
        height: 36px;
        background: var(--brand-orange);
        border-radius: var(--radius-pill);
    }
    .tags-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
    }

    /* Tag chip grid */
    .tag-chip-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.85rem;
    }
    @@media (max-width: 992px) {
        .tag-chip-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 768px) {
        .tag-chip-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 480px) {
        .tag-chip-grid { grid-template-columns: 1fr; }
    }

    .tag-chip {
        position: relative;
        border-radius: var(--radius-pill);
        border: 2px solid;
        padding: 0.7rem 0.5rem 0.7rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background-color: var(--surface);
        transition: transform 0.1s, box-shadow 0.15s;
    }
    .tag-chip:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-hover);
    }
    
    .tag-chip:has(.dropdown.show),
    .tag-chip:has([aria-expanded="true"]) {
        z-index: 10;
        position: relative;
    }

    /* Dropdown menu sits clearly above */
    .tag-chip .dropdown-menu {
        z-index: 20;
    }

    /* Disable chip hover transform while menu is open, so the chip doesn't shift under the menu */
    .tag-chip:has(.dropdown.show):hover,
    .tag-chip:has([aria-expanded="true"]):hover {
        transform: none;
    }
    
    .tag-chip-link {
        flex-grow: 1;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .tag-chip-link:hover {
        color: var(--text-primary);
    }
    .tag-menu-btn {
        background: transparent;
        border: 0;
        color: var(--text-secondary);
        padding: 0.25rem 0.4rem;
        border-radius: 50%;
        cursor: pointer;
        line-height: 1;
        flex-shrink: 0;
        transition: background-color 0.15s, color 0.15s;
    }
    .tag-menu-btn:hover {
        background-color: rgba(0, 0, 0, 0.06);
        color: var(--text-primary);
    }

    /* Color swatch picker */
    .color-swatches {
        display: flex;
        gap: 0.45rem;
        flex-wrap: wrap;
    }
    .color-swatch {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        transition: transform 0.1s;
        position: relative;
    }
    .color-swatch:hover {
        transform: scale(1.1);
    }
    .color-swatch.selected {
        outline: 3px solid var(--brand-orange);
        outline-offset: 2px;
    }

    
</style>

<div class="tags-page">

    <div class="tags-header">
        <div class="tags-header-title">
            <div class="accent-bar"></div>
            <h1>Tags</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="inline-filter-wrap">
                <i class="bi bi-search inline-filter-icon"></i>
                <input type="text" id="tagFilter" class="inline-filter-input" placeholder="Filter tags..." autocomplete="off"/>
            </div>
            <button class="btn btn-pill btn-pill-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">
                <i class="bi bi-plus-lg"></i> New Tag
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="nv-alert alert alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill alert-icon"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="nv-alert alert alert-dismissible fade show" role="alert" style="border-color: var(--danger);">
            <i class="bi bi-exclamation-circle-fill alert-icon" style="color: var(--danger);"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <p>No tags yet.</p>
            <button class="btn btn-pill btn-pill-outline mt-2" data-bs-toggle="modal" data-bs-target="#createTagModal">
                Create your first tag
            </button>
        </div>
    }
    else
    {
        <div class="tag-chip-grid">
            @foreach (var tag in Model)
            {
                var color = tag.Color ?? "#868E96";
                <div class="tag-chip" style="border-color: @color; background-color: @(color)22;">
                    <a asp-action="Details" asp-route-id="@tag.Id" class="tag-chip-link" title="@tag.Name">
                        @tag.Name
                    </a>
                    <div class="dropdown">
                        <button class="tag-menu-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end nv-dropdown">
                            <li>
                                <button class="dropdown-item nv-dropdown-item" data-bs-toggle="modal" data-bs-target="#editTagModal"
                                        onclick="setEditTag(@tag.Id, '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(tag.Name).Trim('"'))', '@(tag.Color ?? "")')">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item nv-dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteTagModal"
                                        onclick="setDeleteTag(@tag.Id, '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(tag.Name).Trim('"'))', @tag.NoteCount)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </div>
        <div class="empty-state" id="noTagMatches" style="display: none;">
            <i class="bi bi-search"></i>
            <p>No tags match your search.</p>
        </div>
    }
</div>

<!-- Create Tag Modal -->
<div class="modal fade nv-modal" id="createTagModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-tag"></i> New Tag
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post" class="nv-form">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control" required autofocus maxlength="50"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Color</label>
                        <div class="color-swatches">
                            @foreach (var color in swatchColors)
                            {
                                <label class="color-swatch" style="background: @color;">
                                    <input type="radio" name="Color" value="@color" class="d-none"/>
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pill btn-pill-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Tag Modal -->
<div class="modal fade nv-modal" id="editTagModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-pencil"></i> Edit Tag
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post" class="nv-form">
                <input type="hidden" name="Id" id="editTagId"/>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" id="editTagName" class="form-control" required maxlength="50"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Color</label>
                        <div class="color-swatches">
                            @foreach (var color in swatchColors)
                            {
                                <label class="color-swatch" style="background: @color;">
                                    <input type="radio" name="Color" value="@color" class="d-none"/>
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pill btn-pill-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Tag Modal -->
<div class="modal fade nv-modal" id="deleteTagModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Delete Tag
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteTagName"></strong>?</p>
                <p id="deleteTagInfo" class="text-muted small"></p>
                <p class="text-muted small">The notes themselves will not be affected.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-pill btn-pill-outline" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="deleteTagId"/>
                    <button type="submit" class="btn btn-pill btn-pill-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setEditTag(id, name, color) {
        document.getElementById('editTagId').value = id;
        document.getElementById('editTagName').value = name;

        document.querySelectorAll('#editTagModal input[name="Color"]').forEach(input => {
            const isSelected = (input.value === color);
            input.checked = isSelected;
            input.closest('.color-swatch').classList.toggle('selected', isSelected);
        });
    }

    function setDeleteTag(id, name, noteCount) {
        document.getElementById('deleteTagId').value = id;
        document.getElementById('deleteTagName').textContent = name;
        const info = document.getElementById('deleteTagInfo');
        if (noteCount > 0) {
            info.textContent = `This tag is currently applied to ${noteCount} ${noteCount === 1 ? 'note' : 'notes'} and will be removed from all of them.`;
        } else {
            info.textContent = '';
        }
    }

    // Swatch selection visual feedback
    document.querySelectorAll('input[name="Color"]').forEach(input => {
        input.addEventListener('change', function() {
            this.closest('.modal').querySelectorAll('input[name="Color"]').forEach(other => {
                other.closest('.color-swatch').classList.toggle('selected', other === this);
            });
        });
    });

    // Reset Create modal on close
    document.getElementById('createTagModal').addEventListener('hidden.bs.modal', function() {
        this.querySelector('form').reset();
        this.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
    });

    const filterInput = document.getElementById('tagFilter');
    const noMatchesEl = document.getElementById('noTagMatches');
    const tagGrid = document.querySelector('.tag-chip-grid');

    if (filterInput && tagGrid) {
        filterInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            const chips = tagGrid.querySelectorAll('.tag-chip');
            let visibleCount = 0;

            chips.forEach(chip => {
                const name = chip.querySelector('.tag-chip-link').textContent.trim().toLowerCase();
                const match = name.includes(query);
                chip.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            noMatchesEl.style.display = visibleCount === 0 && chips.length > 0 ? 'block' : 'none';
        });
    }
</script>
